[Unit]
Description=InstinctFlash Thor Cosmos performance and action regression

[Service]
Type=oneshot
WorkingDirectory=%h/InstinctFlash
EnvironmentFile=%h/.config/instinctflash/thor-regression.env
ExecStart=/usr/bin/env ${REGRESSION_PYTHON} benchmarks/regression/deploy_thor.py --host ${THOR_HOST} --remote-root ${THOR_RESULTS} --python ${THOR_PYTHON} --output-root ${LOCAL_RESULTS} --fixture ${REGRESSION_FIXTURE} --reference ${REGRESSION_REFERENCE}
TimeoutStartSec=2h

{
  "schema": "instinctflash.oss_scope.v1",
  "status": "historical_core_only_proposal_superseded_by_full_source_release",
  "classification_scope": "The rules below preserve the earlier core-only proposal for static audit history. They do not withhold current training, inference, native or serving source from the user-authorized full-source release.",
  "current_full_source_selection": "scripts/build_public_release.py --scope full selects reviewed current source explicitly and preserves package metadata; source/wheel qualification is separate from publication and model/GPU/performance qualification.",
  "audience": "robotics teams deploying existing supported models and compatible fine-tunes",
  "initial_hardware_priority": "Jetson Thor",
  "publication_authorized_by_this_file": false,
  "product_contract": {
    "independent_public_deployment": true,
    "requires_instinct_account_or_private_package_for_basic_use": false,
    "upstream_checkpoint_access_and_licenses_still_apply": true,
    "all_advertised_model_variants_require_real_inference": true,
    "compatible_finetunes_use_public_adapters": true,
    "default_precision": "native",
    "default_transformation_ceiling": "bitexact",
    "numeric_fp8_and_schedule_permissions_are_independent_of_edition": true,
    "public_results_must_use_public_artifacts": true,
    "commercial_speed_gap_measured": false,
    "default_configuration_diagnostics_and_offline_inference_are_public": true
  },
  "inventory_roots": ["instinctflash", "benchmarks", "examples", "serving", "scripts", "tests", "pyproject.toml", "INSTALL.rst", "LICENSE", "README.md", "requirements-serving.txt", "requirements-serving.in", "uv.lock"],
  "package_roots": [
    {"path": "instinctflash", "module": "instinctflash"},

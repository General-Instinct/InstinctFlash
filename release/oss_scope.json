  "release_gates": [
    {"id": "source_boundary", "requirement": "Explicit source and data selection for Git, wheel, sdist and containers; no held modules, implicit symlink imports, unreviewed binary injection or unclassified files.", "status": "not_passed"},
    {"id": "clean_install", "requirement": "Public artifacts plus documented upstream resources install without inherited private environments; record package, source, CUDA and Python versions per family.", "status": "not_passed"},
    {"id": "preflight", "requirement": "Before weight download, report missing adapters, vendor dependencies, incompatible native libraries, device memory and actionable installation fixes.", "status": "not_passed"},
    {"id": "real_actions", "requirement": "Each advertised variant and a representative compatible fine-tune complete Python and WebSocket inference, changing observations/prompts, reset and cleanup with native preprocessing/postprocessing.", "status": "not_passed"},
    {"id": "public_speed", "requirement": "Measure public release end-to-end against declared upstream and available alternative configurations; record warmup, first request, steady latency, memory and actual optimization coverage.", "status": "not_passed"},
    {"id": "quality", "requirement": "Public paired checks and simulator example work; each numerical/behavioral configuration retains its own quality evidence and scope. Small screens cannot grant broader certificates.", "status": "not_passed"},
    {"id": "extension_and_license", "requirement": "Select optional executor interface and compatible licensing after ownership/provenance review. Installing an optional executor cannot raise precision or change schedules silently.", "status": "not_passed"}
  ]
}

--- /dev/null
+++ b/cosmos_framework/data/generator/action/datasets/robotwin_lerobot_dataset.py
@@ -0,0 +1,435 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: OpenMDW-1.1
+
+"""RoboTwin 2.0 ``aloha-agilex`` LeRobot dataset (14-D absolute joint-position policy).
+
+Templated on :class:`LIBEROLeRobotDataset`: a compact per-episode frame index
+(contiguous numpy arrays, copy-on-write across DataLoader worker forks),
+``get_shuffle_blocks`` for ``ActionIterableShuffleDataset``, a deterministic
+per-episode split, and video decoding at each frame's REAL parquet timestamp.
+
+Why NOT ``RoboMINDFrankaDataset``: it indexes ``self._rows[row_idx : row_idx +
+chunk_length + 1]`` off the flat, dataset-global row list and inherits
+``ActionBaseDataset.__len__`` (``len(self._rows) - chunk_length``), with no
+per-episode boundary guard anywhere. Any ``row_idx`` within ``chunk_length`` of
+an episode's last frame therefore produces a window that straddles into the NEXT
+episode: the video frames are decoded from episode ``i`` (a single
+``episode_index`` is read from ``observation_rows[0]``) while the trailing action
+rows come from episode ``i+1``. On RoboMIND's ~500-frame episodes that corrupts
+~3% of windows; on RoboTwin's ~112-frame episodes it would corrupt ~14% of them
+(16/112), and the corrupted windows are exactly the task-completion frames.
+The LIBERO-style index used here allots ``episode_length - chunk_length`` windows
+per episode, so every window is strictly within one episode.
+
+Action layout (14-D, RoboTwin native, joint space)::
+
+    [left_arm(6), left_gripper(1), right_arm(6), right_gripper(1)]
+
+The stored ``actions.qpos14[t]`` is the ABSOLUTE next joint target
+(``actions[t] == states[t+1]``), executed by RoboTwin as
+``TASK_ENV.take_action(a)`` with the default ``action_type='qpos'``. There is no
+pose convention, no rotation encoding, no normalization
+(``action_normalization=None``, so no stats file exists or is needed) and
+**no gripper flip**: RoboTwin's native convention (1.0 = open) is passed through
+verbatim. The DROID / RoboMIND datasets apply ``1.0 - gripper`` at both ends;
+that is a DROID convention and is deliberately NOT copied here.
+
+``use_state=True`` prepends ``states.qpos14[t]`` (the current absolute joint
+position) as action row 0. ``build_sequence_plan_from_mode`` then sees
+``action_length == video_length`` ("Case B"), marks row 0 as a CONDITIONING row
+(``condition_frame_indexes_action == [0]``) and sets
+``action_start_frame_offset = 0`` so action row *k* aligns with video frame *k*.
+That is why the video window must be ``chunk_length + 1`` frames long: with
+``chunk_length=16`` a sample is 17 action rows and 17 video frames.
+
+Video: the ``observation.images.mosaic`` key is a PRE-COMPOSED mosaic written at
+conversion time (head_camera 320x240 on top; left/right wrist cameras each
+resized to 160x120 and concatenated along width below -> 320x360). This class
+reads that single video key and never re-composes from separate camera videos.
+"""
+
+from __future__ import annotations
+
+import random
+from pathlib import Path
+from typing import Any, Literal
+
+import numpy as np
+import pyarrow.parquet as pq
+import torch
+
+from cosmos_framework.data.generator.action.action_spec import ActionSpec, Gripper, Joint, build_action_spec
+from cosmos_framework.data.generator.action.datasets.base_dataset import ActionBaseDataset
+from cosmos_framework.utils import log
+
+Viewpoint = Literal["concat_view"]
+
+#: Embodiment / domain-name string. Registered in ``domain_utils`` as domain id
+#: 11 with raw action dim 14.
+ROBOTWIN_EMBODIMENT: str = "robotwin_aloha_agilex"
+
+_STATE_FEATURE = "observation.states.qpos14"
+_ACTION_FEATURE = "actions.qpos14"
+_MOSAIC_FEATURE = "observation.images.mosaic"
+
+_QPOS_DIM = 14
+
+#: Frozen mosaic geometry (see the module docstring). Used for a one-time
+#: sanity check against the decoded frames, not to resize them.
+MOSAIC_HEIGHT = 360
+MOSAIC_WIDTH = 320
+
+#: Emitted verbatim as ``extras["additional_view_description"]`` and imported
+#: verbatim by the RoboTwin action-policy server, so the prompt the model sees at
+#: eval time is byte-identical to the training prompt.
+ROBOTWIN_VIEW_DESC = (
+    "The top row is a third-person head-camera view of the dual-arm robot. "
+    "The bottom row contains two horizontally concatenated wrist-camera views, left arm then right arm."
+)
+
+# ---------------------------------------------------------------------------
+# Action-row window offset.
+#
+# ``_ACTION_ROW_START_OFFSET`` is the offset, relative to the window's first
+# frame ``t``, of the first SUPERVISED action row:
+#
+#     row 0        = states.qpos14[t]                                (conditioning)
+#     rows 1..16   = actions.qpos14[t + off : t + off + chunk_length] (supervised)
+#
+# The value 1 is what the pilot contract pre-registers, and is what ships here.
+#
+# NOTE (recorded objection, not a silent deviation): off=1 makes row *k* equal
+# ``actions[t+k] == states[t+k+1]``, i.e. one step AHEAD of video frame *k*,
+# while row 0 is ``states[t]`` == video frame 0. off=0 is the self-consistent
+# choice (row k == states[t+k] == the joint configuration visible in video frame
+# k, exactly the alignment ``action_start_frame_offset=0`` declares, and exactly
+# what ``DROIDLeRobotDataset`` does for ``action_space='joint_pos'`` +
+# ``use_state=True``). Flipping this single constant to 0 switches to that
+# alignment; nothing else in the file depends on the value.
+# ---------------------------------------------------------------------------
+_ACTION_ROW_START_OFFSET = 1
+
+
+def robotwin_action_spec() -> ActionSpec:
+    """14-D joint-space spec: ``[left_arm(6), left_gripper, right_arm(6), right_gripper]``.
+
+    All 12 arm columns are :class:`DimType.JOINT` (idle detection by frame-diff
+    against ``joint_threshold``) and the two gripper columns are
+    :class:`DimType.GRIPPER`. No POS/ROT columns: RoboTwin actions are joint
+    targets, so there is no pose convention or rotation format to encode.
+    """
+    return build_action_spec(
+        Joint(n=6, label="arm", prefix="left"),
+        Gripper(prefix="left"),
+        Joint(n=6, label="arm", prefix="right"),
+        Gripper(prefix="right"),
+    )
+
+
+class RoboTwinLeRobotDataset(ActionBaseDataset):
+    """RoboTwin 2.0 ``aloha-agilex`` 14-D absolute-joint-position policy dataset.
+
+    One dataset root spans all pilot tasks (multi-task, one checkpoint); tasks
+    are distinguished only by the LeRobot ``task_index`` -> instruction string.
+    """
+
+    def __init__(
+        self,
+        root: str,
+        fps: float = 16.0,
+        chunk_length: int = 16,
+        mode: str = "policy",
+        tolerance_s: float = 1e-4,
+        viewpoint: Viewpoint = "concat_view",
+        use_state: bool = True,
+        embodiment_type: str = ROBOTWIN_EMBODIMENT,
+        action_normalization: str | None = None,
+        split: str = "full",
+        val_ratio: float = 0.01,
+        seed: int = 0,
+        sample_stride: int = 1,
+    ) -> None:
+        if viewpoint != "concat_view":
+            raise NotImplementedError(
+                f"RoboTwinLeRobotDataset only supports viewpoint='concat_view' (the pre-composed "
+                f"{_MOSAIC_FEATURE!r} mosaic), got {viewpoint!r}."
+            )
+        if action_normalization is not None:
+            # No normalizer stats file exists for RoboTwin, by design: the pilot
+            # protocol pins action_normalization=None so there is no train/serve
+            # normalizer mismatch to get wrong.
+            raise ValueError(
+                "RoboTwinLeRobotDataset requires action_normalization=None (raw absolute qpos14); "
+                f"got {action_normalization!r}. No stats file exists for this embodiment."
+            )
+        split = split.lower().strip()
+        if split not in {"train", "val", "valid", "validation", "eval", "test", "full"}:
+            raise ValueError(f"Unsupported split={split!r}. Use train/val/full.")
+        if chunk_length < 1:
+            raise ValueError(f"chunk_length must be >= 1, got {chunk_length}.")
+
+        super().__init__(
+            root=root,
+            domain_name=embodiment_type,
+            fps=fps,
+            chunk_length=chunk_length,
+            # Joint-space actions have no pose deltas; this only satisfies the
+            # base-class assert and is never read (see _action_spec: no POS/ROT).
+            pose_convention="backward_framewise",
+            mode=mode,
+            tolerance_s=tolerance_s,
+            viewpoint=viewpoint,
+            action_normalization=None,
+            sample_stride=sample_stride,
+        )
+        self._embodiment_type = embodiment_type
+        self._use_state = bool(use_state)
+        self._warned_geometry = False
+
+        # ``conditioning_fps`` is emitted as torch.long, so a non-integer fps is
+        # silently truncated. RoboTwin's true rate is 16.67 Hz (save_freq 15 at
+        # timestep 1/250); the pilot pins 16 everywhere (data timestamps,
+        # conditioning_fps, mp4 rate) so it is exact rather than truncated.
+        info_fps = self._info.get("fps")
+        if info_fps is not None and abs(float(info_fps) - float(fps)) > 1e-6:
+            raise ValueError(
+                f"fps mismatch: dataset meta/info.json says fps={info_fps} but the recipe requested "
+                f"{fps}. The converter and the recipe must agree (the pilot pins 16)."
+            )
+        if not float(self._fps).is_integer():
+            raise ValueError(
+                f"fps must be an integer ({self._fps} given): conditioning_fps is cast to torch.long, "
+                "so a fractional fps would be silently truncated."
+            )
+
+        self._validate_features()
+
+        # Compact, lazy frame index (mirrors LIBEROLeRobotDataset / DROID): read
+        # only the columns the sample builder needs into contiguous arrays,
+        # ordered by global frame index, so DataLoader worker forks share them
+        # copy-on-write. Never touches ActionBaseDataset._rows.
+        index_parts: list[np.ndarray] = []
+        episode_parts: list[np.ndarray] = []
+        task_parts: list[np.ndarray] = []
+        ts_parts: list[np.ndarray] = []
+        state_parts: list[np.ndarray] = []
+        action_parts: list[np.ndarray] = []
+        for path in sorted((self._root / "data").glob("chunk-*/file-*.parquet")):
+            table = pq.read_table(
+                path,
+                columns=["index", "episode_index", "task_index", "timestamp", _STATE_FEATURE, _ACTION_FEATURE],
+            )
+            index_parts.append(table["index"].to_numpy())
+            episode_parts.append(table["episode_index"].to_numpy())
+            task_parts.append(table["task_index"].to_numpy())
+            ts_parts.append(table["timestamp"].to_numpy())
+            state_parts.append(np.asarray(table[_STATE_FEATURE].to_pylist(), dtype=np.float32))
+            action_parts.append(np.asarray(table[_ACTION_FEATURE].to_pylist(), dtype=np.float32))
+        if not index_parts:
+            raise FileNotFoundError(f"No data parquet found under {self._root / 'data'}.")
+        order = np.argsort(np.concatenate(index_parts).astype(np.int64), kind="stable")
+        self._row_episode = np.concatenate(episode_parts).astype(np.int64)[order]
+        self._row_task = np.concatenate(task_parts).astype(np.int64)[order]
+        self._row_timestamp = np.concatenate(ts_parts).astype(np.float64)[order]
+        self._row_state = np.concatenate(state_parts, axis=0).astype(np.float32)[order]
+        self._row_action = np.concatenate(action_parts, axis=0).astype(np.float32)[order]
+
+        for name, arr in ((_STATE_FEATURE, self._row_state), (_ACTION_FEATURE, self._row_action)):
+            if arr.ndim != 2 or arr.shape[1] != _QPOS_DIM:
+                raise ValueError(f"{name} must be [T, {_QPOS_DIM}]; got {tuple(arr.shape)} at {self._root}.")
+
+        assert np.all(np.diff(self._row_episode) >= 0), "episode_index not contiguous after sorting by frame index"
+        ep_vals, ep_starts, ep_counts = np.unique(self._row_episode, return_index=True, return_counts=True)
+
+        # Deterministic per-episode split (seeded; identical on every rank).
+        # The pilot trains on all 5,500 episodes -> split="full" (no held-out demos).
+        keep = self._split_episode_ids(ep_vals.tolist(), split, val_ratio, seed)
+        kept = np.array([int(v) in keep for v in ep_vals], dtype=bool)
+        self._ep_vals = ep_vals.astype(np.int64)[kept]
+        self._ep_starts = ep_starts.astype(np.int64)[kept]
+        kept_counts = ep_counts.astype(np.int64)[kept]
+        # WITHIN-episode windows only: an episode of length L yields
+        # L - chunk_length windows, whose last touched row is start + chunk_length
+        # (the 17th video frame / the last action row) -> always inside the episode.
+        self._valid_cum = np.cumsum(np.maximum(0, kept_counts - self._chunk_length)).astype(np.int64)
+
+        log.info(
+            f"Loaded RoboTwin dataset root={self._root} split={split!r} viewpoint={viewpoint!r} "
+            f"fps={self._fps} chunk_length={self._chunk_length} use_state={self._use_state} "
+            f"kept_episodes={len(self._ep_vals)}/{len(ep_vals)} tasks={len(self._tasks)} "
+            f"valid_indices={len(self)}"
+        )
+
+    # ---- schema validation -------------------------------------------------
+
+    def _validate_features(self) -> None:
+        """Fail loudly at construction if the converter wrote a different schema."""
+        features = self._info.get("features", {})
+        for name in (_STATE_FEATURE, _ACTION_FEATURE):
+            feat = features.get(name)
+            if feat is None:
+                raise KeyError(
+                    f"Missing feature {name!r} in {self._root / 'meta' / 'info.json'}. "
+                    f"Available: {sorted(features)}"
+                )
+            shape = list(feat.get("shape", []))
+            if shape != [_QPOS_DIM]:
+                raise ValueError(f"Feature {name!r} must have shape [{_QPOS_DIM}]; info.json says {shape}.")
+            if feat.get("dtype") not in (None, "float32"):
+                raise ValueError(f"Feature {name!r} must be float32; info.json says {feat.get('dtype')!r}.")
+        if _MOSAIC_FEATURE not in features:
+            raise KeyError(
+                f"Missing video feature {_MOSAIC_FEATURE!r} in {self._root / 'meta' / 'info.json'}. "
+                "This dataset reads the PRE-COMPOSED mosaic only; it does not re-compose "
+                f"per-camera videos. Available: {sorted(features)}"
+            )
+
+    # ---- spec / dims -------------------------------------------------------
+
+    @property
+    def action_dim(self) -> int:
+        return _QPOS_DIM
+
+    def _action_spec(self) -> ActionSpec:
+        return robotwin_action_spec()
+
+    @classmethod
+    def _stats_path(cls) -> Path:
+        raise NotImplementedError(
+            "RoboTwin actions are raw absolute qpos14 (action_normalization=None); "
+            "there is no normalizer stats file by design."
+        )
+
+    def _load_norm_stats(self) -> dict[str, torch.Tensor]:
+        # Unreachable while action_normalization is pinned to None (the base only
+        # calls this when self.action_normalization is truthy), but make the
+        # failure explicit instead of a FileNotFoundError on a bogus path.
+        raise NotImplementedError(
+            "RoboTwin actions are not normalized; _load_norm_stats must never be called."
+        )
+
+    # ---- index helpers -----------------------------------------------------
+
+    @staticmethod
+    def _split_episode_ids(ep_ids: list[int], split: str, val_ratio: float, seed: int) -> set[int]:
+        if split == "full":
+            return {int(v) for v in ep_ids}
+        if not (0.0 < val_ratio < 1.0):
+            raise ValueError(f"val_ratio must be in (0, 1), got {val_ratio}.")
+        n_val = max(1, int(round(len(ep_ids) * val_ratio)))
+        rng = random.Random(seed)  # identical selection on every rank
+        val = {int(v) for v in rng.sample(list(ep_ids), n_val)}
+        if split == "train":
+            return {int(v) for v in ep_ids} - val
+        return val  # val/valid/validation/eval/test
+
+    def __len__(self) -> int:
+        return int(self._valid_cum[-1]) if self._valid_cum.size else 0
+
+    def get_shuffle_blocks(self) -> list[tuple[int, int]]:
+        """Per-episode ``(start, length)`` flat-index blocks for
+        ``ActionIterableShuffleDataset`` (shuffle block ORDER + shard across
+        ranks, sequential within a block)."""
+        blocks: list[tuple[int, int]] = []
+        prev = 0
+        for c in np.asarray(self._valid_cum).tolist():
+            c = int(c)
+            if c > prev:
+                blocks.append((prev, c - prev))
+            prev = c
+        return blocks
+
+    # ---- sample build ------------------------------------------------------
+
+    def __getitem__(self, idx: int) -> dict[str, Any]:
+        # Resample a different valid window if a frame fails to decode (bounded retries).
+        n = len(self)
+        last_err: Exception | None = None
+        for _attempt in range(8):
+            try:
+                return self._build_item(idx)
+            except Exception as e:  # noqa: BLE001 — skip past undecodable frames
+                last_err = e
+                log.warning(f"RoboTwin: sample idx={idx} failed to load ({type(e).__name__}: {e}); resampling")
+                if n > 0:
+                    idx = random.randint(0, n - 1)
+        raise RuntimeError(f"RoboTwin: failed to load a sample after 8 resamples; last error: {last_err}")
+
+    def _build_item(self, idx: int) -> dict[str, Any]:
+        mode = self._choose_mode()
+        idx = int(idx)
+        ep = int(np.searchsorted(self._valid_cum, idx, side="right"))
+        prev = int(self._valid_cum[ep - 1]) if ep > 0 else 0
+        start = int(self._ep_starts[ep]) + (idx - prev)
+        episode_index = int(self._ep_vals[ep])
+        episode = self._episodes[episode_index]
+
+        # chunk_length + 1 video frames (17 at chunk_length=16): frame 0 is the
+        # conditioning frame, frames 1..chunk_length are predicted. video_length
+        # must equal the action-row count for the Case-B sequence plan.
+        stop = start + self._chunk_length + 1
+        timestamps = [float(self._row_timestamp[j]) for j in range(start, stop)]
+        video = self._load_video(episode, timestamps)
+
+        action = self._build_action(start)
+
+        task = self._tasks[int(self._row_task[start])]
+        # The converter joins an episode's ``seen`` instruction pool with " | ";
+        # sample one phrasing per window (same convention as DROID/LIBERO).
+        ai_caption = random.choice([p.strip() for p in task.split(" | ") if p.strip()] or [task])
+
+        return self._build_result(
+            mode=mode,
+            video=video,
+            action=action,
+            ai_caption=ai_caption,
+            additional_view_description=ROBOTWIN_VIEW_DESC,
+        )
+
+    def _build_action(self, start: int) -> torch.Tensor:
+        """Absolute qpos14 action rows for the window beginning at flat row ``start``.
+
+        ``chunk_length`` supervised rows, plus (``use_state``) the current
+        absolute state as conditioning row 0. Raw values: no normalization, no
+        gripper flip.
+        """
+        off = _ACTION_ROW_START_OFFSET
+        rows = self._row_action[start + off : start + off + self._chunk_length]  # [chunk, 14]
+        action = torch.from_numpy(np.ascontiguousarray(rows)).float()
+        if self._use_state:
+            state = torch.from_numpy(np.ascontiguousarray(self._row_state[start])).float()  # [14]
+            action = torch.cat([state.unsqueeze(0), action], dim=0)  # [chunk + 1, 14]
+        return action
+
+    def _load_video(self, episode: dict[str, Any], timestamps: list[float]) -> torch.Tensor:
+        """Decode the pre-composed mosaic at the window's real frame timestamps."""
+        # lerobot is a heavy, optional ("train" extra) dependency; import lazily.
+        from lerobot.datasets.video_utils import decode_video_frames
+
+        from_ts = float(episode.get(f"videos/{_MOSAIC_FEATURE}/from_timestamp", 0.0))
+        frames = decode_video_frames(
+            self._video_path(episode, _MOSAIC_FEATURE),
+            [from_ts + ts for ts in timestamps],
+            self._tolerance_s,
+        )  # [T, C, H, W] in [0, 1]
+        h, w = int(frames.shape[-2]), int(frames.shape[-1])
+        if (h, w) != (MOSAIC_HEIGHT, MOSAIC_WIDTH) and not self._warned_geometry:
+            self._warned_geometry = True
+            log.warning(
+                f"RoboTwin mosaic geometry is {h}x{w}, expected {MOSAIC_HEIGHT}x{MOSAIC_WIDTH} "
+                "(head 320x240 on top; two 160x120 wrist views below). The frozen geometry must "
+                "match the policy server's mosaic, or train/serve inputs differ."
+            )
+        # No resize here: ActionTransformPipeline resizes/reflection-pads to the
+        # resolution tier, and the server applies the identical transform.
+        return frames
+
+
+__all__ = [
+    "MOSAIC_HEIGHT",
+    "MOSAIC_WIDTH",
+    "ROBOTWIN_EMBODIMENT",
+    "ROBOTWIN_VIEW_DESC",
+    "RoboTwinLeRobotDataset",
+    "robotwin_action_spec",
+]

+# ---------------------------------------------------------------------------
+# Timing instrumentation
+# ---------------------------------------------------------------------------
+
+
+@dataclass
+class _PhaseTimings:
+    """One request's worth of model-internal sub-timers (milliseconds)."""
+
+    prepare_ms: float = 0.0
+    vision_encode_ms: float = 0.0
+    prompt_tokenize_ms: float = 0.0
+    pack_prepare_ms: float = 0.0
+    pack_in_denoise_ms: float = 0.0
+    velocity_ms: list[float] = field(default_factory=list)
+    first_velocity_t0: float | None = None
+    last_velocity_t1: float | None = None
+    sequence_length: int | None = None
+
+    @property
+    def nfe(self) -> int:
+        return len(self.velocity_ms)
+
+    @property
+    def denoise_loop_ms(self) -> float:
+        if self.first_velocity_t0 is None or self.last_velocity_t1 is None:
+            return 0.0
+        return (self.last_velocity_t1 - self.first_velocity_t0) * 1000.0
+
+
+class _ModelTimingProbe:
+    """Wraps ``OmniMoTModel`` internals with timers, without editing the model.
+
+    The instrumented boundaries were chosen to split the *fixed* per-chunk cost
+    (which dominates at low step counts) into attackable pieces:
+
+    ==============================  ===========================================
+    ``get_data_and_condition``      vision/VAE encode of the conditioning frame
+    ``_get_inference_text_tokens``  prompt tokenization (VLM chat template)
+    ``_pack_input_sequence``        sequence packing (once in prepare, then once
+                                    per network forward inside the denoise loop)
+    ``_prepare_inference_data``     everything above plus noise init
+    ``_get_velocity``              one network forward = one NFE
+    ==============================  ===========================================
+
+    Because CUDA work is asynchronous, wall-clock around an un-synchronized call
+    attributes GPU time to whatever later call happens to block.  With
+    ``sync=True`` (default) each boundary calls ``torch.cuda.synchronize()``, which
+    makes the breakdown truthful at the cost of removing a little launch-queue
+    overlap; ``--no-sync-timing`` restores the fastest possible wall time and
+    reports a breakdown that must not be trusted component-by-component.
+
+    All inference in this server is serialized under one lock, so a single
+    timing slot is sufficient; ``reset()`` is called at the start of each request.
+    """
+
+    def __init__(self, model: Any, *, sync: bool = True) -> None:
+        self.sync = bool(sync)
+        self.current = _PhaseTimings()
+        self._in_velocity = False
+        self._installed_on = model
+
+        model.get_data_and_condition = self._timed(model.get_data_and_condition, "vision_encode_ms")
+        model._get_inference_text_tokens = self._timed(model._get_inference_text_tokens, "prompt_tokenize_ms")
+        model._prepare_inference_data = self._timed(model._prepare_inference_data, "prepare_ms")
+        model._pack_input_sequence = self._timed_pack(model._pack_input_sequence)
+        model._get_velocity = self._timed_velocity(model._get_velocity)
+
+    def reset(self) -> None:
+        self.current = _PhaseTimings()
+        self._in_velocity = False
+
+    def _sync_point(self) -> None:
+        if self.sync and torch.cuda.is_available():
+            torch.cuda.synchronize()
+
+    def _timed(self, fn: Callable[..., Any], attr: str) -> Callable[..., Any]:
+        def wrapper(*args: Any, **kwargs: Any) -> Any:
+            self._sync_point()
+            t0 = time.perf_counter()
+            try:
+                return fn(*args, **kwargs)
+            finally:
+                self._sync_point()
+                setattr(self.current, attr, getattr(self.current, attr) + (time.perf_counter() - t0) * 1000.0)
+
+        return wrapper
+
+    def _timed_pack(self, fn: Callable[..., Any]) -> Callable[..., Any]:
+        def wrapper(*args: Any, **kwargs: Any) -> Any:
+            # No sync: packing is CPU-side bookkeeping plus H2D copies, and syncing
+            # here would fire once per denoise step for no information gain.
+            t0 = time.perf_counter()
+            packed = fn(*args, **kwargs)
+            dt_ms = (time.perf_counter() - t0) * 1000.0
+            if self._in_velocity:
+                self.current.pack_in_denoise_ms += dt_ms
+            else:
+                self.current.pack_prepare_ms += dt_ms
+            seq_len = getattr(packed, "sequence_length", None)
+            if isinstance(seq_len, int) and seq_len > 0:
+                self.current.sequence_length = seq_len
+            return packed
+
+        return wrapper
+
+    def _timed_velocity(self, fn: Callable[..., Any]) -> Callable[..., Any]:
+        def wrapper(*args: Any, **kwargs: Any) -> Any:
+            self._sync_point()
+            t0 = time.perf_counter()
+            if self.current.first_velocity_t0 is None:
+                self.current.first_velocity_t0 = t0
+            self._in_velocity = True
+            try:
+                return fn(*args, **kwargs)
+            finally:
+                self._in_velocity = False
+                self._sync_point()
+                t1 = time.perf_counter()
+                self.current.last_velocity_t1 = t1
+                self.current.velocity_ms.append((t1 - t0) * 1000.0)
+
+        return wrapper
+
+
+def _stats(values: list[float]) -> dict[str, float | None]:
+    if not values:
+        return {"mean": None, "min": None, "max": None, "p50": None}
+    ordered = sorted(values)
+    return {
+        "mean": round(statistics.fmean(values), 3),
+        "min": round(ordered[0], 3),
+        "max": round(ordered[-1], 3),
+        "p50": round(ordered[len(ordered) // 2], 3),
+    }
+
+

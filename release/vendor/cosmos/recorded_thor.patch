+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: OpenMDW-1.1
+
+# ============================================================================
+# RoboTwin 2.0 pilot — run config for the `action_policy_robotwin_edge`
+# experiment (base nvidia/Cosmos3-Edge, 3.86B; ONE multi-task checkpoint over
+# the 10 ManipDojo-2026-Round1 tasks).
+#
+# Pre-registered in docs/robotwin_pilot_protocol.md §3:
+#   HSDP shard 8 x replicate 1, grad_accum 2, max_samples_per_batch 128
+#     -> global batch 128 x 8 x 2 = 2048
+#   lr 5e-5, warm_up_steps 500, cycle_lengths [max_iter], bf16,
+#   selective activation checkpointing on fmha, save_iter = max_iter / 10.
+#
+# The backbone (Nano -> Edge) is NOT settable here: PATH_REMAPS["vfm"] maps
+# ("model","backbone") -> None, so it lives in the registered experiment.
+#
+# Env required:
+#   ROBOTWIN_ROOT=<one LeRobot v3.0 root covering the 10 pilot tasks>
+#   BASE_CHECKPOINT_PATH=<base Cosmos3-Edge DCP dir — NOT Cosmos3-Edge-Policy-DROID>
+#   WAN_VAE_PATH=<Wan2.2_VAE.pth>
+#   IMAGINAIRE_OUTPUT_ROOT=<output root>   # persists checkpoints
+# ============================================================================
+
+[job]
+task         = "vfm"
+experiment   = "action_policy_robotwin_edge"
+project      = "cosmos3_action_robotwin"
+group        = "action_sft"
+name         = "action_policy_robotwin_edge"
+wandb_mode   = "offline"    # log locally; `wandb sync` later (no API key on this host)
+
+[model]
+precision = "bfloat16"
+# Edge default. Headroom check: 17 frames -> latent T = 1 + 16/4 = 5; at the
+# 480 tier's 640x640 bucket the patchified side is 640/16/2 = 20, so a sample is
+# 5 x 20 x 20 = 2000 vision tokens. Well under the cap, so no uncapping needed.
+max_num_tokens_after_packing = 45056
+
+[model.parallelism]
+data_parallel_shard_degree     = 8   # one 8-GPU node, fully sharded
+data_parallel_replicate_degree = 1   # HSDP 1x8 = 8 ranks
+
+[model.activation_checkpointing]
+mode           = "selective"
+save_ops_regex = ["fmha"]
+
+[model.tokenizer]
+vae_path = "${oc.env:WAN_VAE_PATH}"
+
+[optimizer]
+lr = 5.0e-05
+
+[scheduler]
+# cycle_lengths = [max_iter]  -> the linear decay ends exactly at the last step.
+# MUST be set to the same value as [trainer].max_iter below.
+cycle_lengths = [3200]        # = max_iter (PRE-REGISTERED 2026-07-25)
+warm_up_steps = [500]
+
+[trainer]
+# ==========================================================================
+# >>> PLACEHOLDER THE OPERATOR MUST SET BEFORE LAUNCHING <<<
+#
+# max_iter is PRE-REGISTERED from the converter's measured window count so the
+# run lands in the 3-5 epoch band (protocol §3). Do not guess it here.
+#
+#   windows_per_epoch = sum over episodes of (episode_length - 16)
+#   max_iter          = round(epochs * windows_per_epoch / 2048)     # global batch 2048
+#
+# Order of operations:
+#   1. run the converter over all 5,500 episodes; read its reported window count;
+#   2. write max_iter AND [scheduler].cycle_lengths (same number) here;
+#   3. record both, the window count and the epoch count, in
+#      docs/robotwin_pilot_deviations.md BEFORE training starts;
+#   4. set [checkpoint].save_iter = max_iter / 10.
+#
+# Sanity scale only (NOT a substitute for the measured count): ~112 frames/episode
+# -> ~96 windows/episode -> ~528k windows -> ~258 iters/epoch -> ~775-1290 iters
+# for 3-5 epochs.
+# ==========================================================================
+max_iter        = 3200        # PRE-REGISTERED: 1,617,627 windows / gbs 2048 = 4.05 epochs
+grad_accum_iter = 2           # global batch = 128 x (shard 8 x replicate 1) x 2 = 2048
+logging_iter    = 10
+
+[trainer.callbacks.grad_clip]
+clip_norm    = 1.0
+force_finite = true
+
+[checkpoint]
+load_path = "${oc.env:BASE_CHECKPOINT_PATH}"
+save_iter = 320             # = max_iter / 10
+
+[dataloader_train]
+max_samples_per_batch = 128   # per rank, per micro-batch
+
+# ----------------------------------------------------------------------------
+# If 128 samples/rank OOMs at the 480 tier (2000 vision tokens/sample x 128 =
+# 256k tokens/rank, ~2.3x the per-rank vision load of the DROID reference run),
+# preserve the pre-registered global batch of 2048 by trading samples for accum
+# at launch, e.g.:
+#   --opts dataloader_train.max_samples_per_batch=64 trainer.grad_accum_iter=4
+# and record the trade in the deviations file. Never change the product.
+# ----------------------------------------------------------------------------

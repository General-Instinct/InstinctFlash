+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: OpenMDW-1.1
+
+"""``action_policy_robotwin_edge`` — Cosmos3-Edge RoboTwin 2.0 action-policy SFT recipe.
+
+Structured on ``action_policy_droid_nano`` but on the EDGE backbone
+(``copy.deepcopy(EDGE_MODEL_CONFIG)``, Nemotron-2B-Dense-VL / base
+``nvidia/Cosmos3-Edge``, 3.86B). The Nano -> Edge swap CANNOT be expressed as a
+TOML override: ``toml_config_helper.PATH_REMAPS["vfm"]`` maps
+``("model", "backbone")`` to ``None`` (VFM has no ``model.config.backbone``), so
+the backbone is only selectable by which model-config constant this experiment
+deep-copies. Hence a separate registered experiment rather than a TOML variant of
+the DROID recipe.
+
+Data: ``RoboTwinLeRobotDataset`` via ``get_action_robotwin_sft_dataset`` — 14-D
+absolute joint position ``qpos14`` ``[left_arm(6), left_gripper, right_arm(6),
+right_gripper]``, ``use_state=True`` (current state = conditioning action row 0
+-> 17 action rows / 17 video frames at ``chunk_length=16``),
+``action_normalization=None``, no gripper flip, ``concat_view`` over the single
+pre-composed ``observation.images.mosaic`` (320x360) video key, fps 16. ONE
+dataset root and ONE checkpoint over the 10 pilot tasks.
+
+Usage (1 node, 8 GPU)::
+
+    ROBOTWIN_ROOT=/path/to/robotwin_lerobot_root \\
+    BASE_CHECKPOINT_PATH=<Cosmos3-Edge DCP dir> \\
+    WAN_VAE_PATH=<Wan2.2_VAE.pth> \\
+    IMAGINAIRE_OUTPUT_ROOT=<output root> \\
+    torchrun --nproc_per_node=8 -m cosmos_framework.scripts.train \\
+        --sft-toml examples/toml/sft_config/action_policy_robotwin_edge.toml
+"""
+
+import copy
+
+from hydra.core.config_store import ConfigStore
+
+from cosmos_framework.configs.base.experiment.sft.models.edge_model_config import EDGE_MODEL_CONFIG
+from cosmos_framework.data.generator.action.datasets.action_sft_dataset import get_action_robotwin_sft_dataset
+from cosmos_framework.data.generator.joint_dataloader import (
+    PackingDataLoader,
+    RankPartitionedDataLoader,
+)
+from cosmos_framework.utils.lazy_config import LazyCall as L
+from cosmos_framework.utils.lazy_config import LazyDict
+
+cs = ConfigStore.instance()
+
+# chunk_length=16 + use_state -> 17 video frames per sample.
+_CHUNK_LENGTH = 16
+_VIDEO_FRAMES = _CHUNK_LENGTH + 1
+
+
+def _action_policy_robotwin_edge_model_config() -> dict:
+    """Edge baseline + the RoboTwin action-policy deltas.
+
+    ``EDGE_MODEL_CONFIG`` already carries ``action_gen=True``,
+    ``max_action_dim=64``, ``resolution="480"``, ``loss_scale=10.0``,
+    ``image_loss_scale=None`` and ``action_loss_weight=10.0``, so the only
+    deltas are the VAE encode duration and selective activation checkpointing.
+    """
+    cfg = copy.deepcopy(EDGE_MODEL_CONFIG)  # action_gen=True, max_action_dim=64, resolution="480"
+    # Selective AC on fmha (the pre-registered schedule); Edge's baseline is "full".
+    cfg["activation_checkpointing"]["mode"] = "selective"
+    # 17-frame windows: encode at their exact length instead of padding to
+    # 1 + encode_chunk_frames["480"] = 25 frames.
+    cfg["tokenizer"]["encode_exact_durations"] = [_VIDEO_FRAMES]
+    return cfg
+
+
+action_policy_robotwin_edge = LazyDict(
+    dict(
+        defaults=[
+            {"override /model": "mot_fsdp"},
+            {"override /data_train": None},
+            {"override /data_val": None},
+            # FusedAdam with fp32 master_weights + eps 1e-8 (bf16 params + eps 1e-6
+            # diverged on the action loss).
+            {"override /optimizer": "fusedadamw"},
+            {"override /scheduler": "lambdalinear"},  # linear LR decay
+            {"override /checkpoint": "s3"},
+            {
+                "override /callbacks": [
+                    "basic",
+                    "optimization",
+                    "job_monitor",
+                ]
+            },
+            {"override /ema": "power"},
+            {"override /tokenizer": "wan2pt2_tokenizer"},
+            {"override /sound_tokenizer": None},
+            {"override /vlm_config": None},
+            {"override /ckpt_type": "dcp"},
+            "_self_",
+        ],
+        job=dict(
+            project="cosmos3_action_robotwin",
+            group="action_sft",
+            name="action_policy_robotwin_edge",
+            wandb_mode="disabled",
+        ),
+        model=dict(
+            config=_action_policy_robotwin_edge_model_config(),
+        ),
+        optimizer=dict(
+            betas=[0.9, 0.99],
+            eps=1.0e-08,
+            fused=True,  # popped by build_optimizer for FusedAdam (fused by construction)
+            # Train the generation + action heads.
+            keys_to_select=[
+                "moe_gen",
+                "time_embedder",
+                "vae2llm",
+                "llm2vae",
+                "action2llm",
+                "llm2action",
+                "action_modality_embed",
+                # EDGE-ONLY, and the reason this list differs from the Nano action
+                # recipes: edge_model_config sets use_und_k_norm_for_gen=True with
+                # qk_norm_for_text=False, so UnifiedMoTAttention builds a real
+                # RMSNorm named ``k_norm_und_for_gen`` (unified_mot.py:532). That
+                # name does NOT contain the substring "moe_gen", so with the Nano
+                # key list _build_params_with_metadata would flip its
+                # requires_grad to False and silently FREEZE the norm that scales
+                # every und K token the generator cross-attends to. vision_sft_edge
+                # lists it for exactly this reason; the Nano action recipes omit it
+                # only because Nano has qk_norm_for_text=True and therefore never
+                # constructs the module.
+                "k_norm_und_for_gen",
+            ],
+            lr=5.0e-05,  # pre-registered (protocol §3); global batch 2048
+            lr_multipliers={
+                "action2llm": 5.0,
+                "llm2action": 5.0,
+                "action_modality_embed": 5.0,
+            },
+            optimizer_type="FusedAdam",
+            weight_decay=0.05,
+        ),
+        scheduler=dict(
+            lr_scheduler_type="LambdaLinear",
+            cycle_lengths=[100],  # smoke: 100 iters (real run sets cycle_lengths=[max_iter] via TOML)
+            f_max=[1.0],
+            f_min=[0.0],
+            f_start=[1.0e-06],
+            verbosity_interval=0,
+            warm_up_steps=[0],  # smoke (real run sets 500 via TOML)
+        ),
+        trainer=dict(
+            distributed_parallelism="fsdp",
+            grad_accum_iter=1,  # real run sets 2 via TOML
+            logging_iter=1,
+            max_iter=100,  # smoke (real run sets the pre-registered value via TOML)
+            max_val_iter=None,
+            run_validation=False,
+            run_validation_on_start=False,
+            save_zero_checkpoint=False,
+            seed=42,
+            timeout_period=999999999,
+            validation_iter=100,
+            compile_config=dict(recompile_limit=8, use_duck_shape=False),
+            cudnn=dict(benchmark=True, deterministic=False),
+            ddp=dict(broadcast_buffers=True, find_unused_parameters=False, static_graph=True),
+            grad_scaler_args=dict(enabled=False),
+            callbacks=dict(
+                dataloader_speed=dict(every_n=100, save_s3=False, step_size=1),
+                device_monitor=dict(
+                    every_n=200, log_memory_detail=True, save_s3=False, step_size=1, upload_every_n_mul=5
+                ),
+                grad_clip=dict(clip_norm=1.0, force_finite=True),
+                heart_beat=dict(every_n=200, save_s3=False, step_size=1, update_interval_in_minute=20),
+                iter_speed=dict(every_n=1, hit_thres=50, save_s3=False, save_s3_every_log_n=500),
+                low_precision=dict(update_iter=1),
+                manual_gc=dict(every_n=5, gc_level=1, warm_up=1),
+                param_count=dict(save_s3=False),
+                skip_nan_step=dict(max_consecutive_nan=100),
+                training_stats=dict(log_freq=100),
+            ),
+        ),
+        checkpoint=dict(
+            broadcast_via_filesystem=False,
+            dcp_async_mode_enabled=False,
+            enable_gcs_patch_in_boto3=True,
+            keys_not_to_resume=[],
+            # Skip net_ema (EMA warm-starts from net, see dcp.py) and the action
+            # heads, so they init FRESH from the base: the released Cosmos3-Edge
+            # ships DROID-trained action heads whose domain-11 row is untrained,
+            # and whose chunk geometry differs from ours.
+            keys_to_skip_loading=[
+                "net_ema.",
+                "action2llm",
+                "llm2action",
+                "action_modality_embed",
+                "action_pos_embed",
+            ],
+            load_ema_to_reg=False,
+            load_path="???",  # base Cosmos3-Edge DCP dir; supply via TOML/env
+            load_training_state=False,
+            only_load_scheduler_state=False,
+            save_iter=100,  # smoke (real run sets max_iter/10 via TOML)
+            strict_resume=False,  # base init: tolerate key set differences
+            verbose=True,
+            hf_export=dict(
+                enabled=False,
+                export_every_n=1,
+                hf_repo_id=None,
+                upload_to_object_store=dict(bucket="", credentials="", enabled=False),
+            ),
+            jit=dict(device="cuda", dtype="bfloat16", enabled=False, input_shape=None, strict=True),
+            load_from_object_store=dict(bucket="", credentials="", enabled=False),
+            save_to_object_store=dict(bucket="", credentials="", enabled=False),
+        ),
+        dataloader_train=L(PackingDataLoader)(
+            audio_sample_rate=48000,
+            dataset_name="action_robotwin",
+            # 128 x (shard 8 x replicate 1) x grad_accum 2 = 2048 global batch.
+            max_samples_per_batch=128,
+            max_sequence_length=None,  # None disables token packing (TOML can't express null)
+            patch_spatial=2,
+            sound_latent_fps=0,
+            tokenizer_spatial_compression_factor=16,
+            tokenizer_temporal_compression_factor=4,
+            dataloader=L(RankPartitionedDataLoader)(
+                batch_size=1,
+                in_order=False,
+                num_workers=4,
+                persistent_workers=True,
+                pin_memory=True,
+                prefetch_factor=4,
+                sampler=None,
+                # Shuffling is handled by the dataset (iterable_shuffle=True below):
+                # ActionIterableShuffleDataset streams rank x worker-sharded, episode-order-
+                # shuffled, sequential-within-episode. RoboTwin episodes are short (~112
+                # frames -> ~96 windows), so a rank's workers cycle episodes quickly.
+                datasets=dict(
+                    robotwin=dict(
+                        ratio=1,
+                        dataset=L(get_action_robotwin_sft_dataset)(
+                            # ONE LeRobot v3.0 root over the 10 pilot tasks.
+                            root="${oc.env:ROBOTWIN_ROOT}",
+                            # 16 everywhere (timestamps, conditioning_fps, mp4 rate).
+                            # The true RoboTwin rate is 16.67 Hz; conditioning_fps is cast
+                            # to torch.long, so a fractional value would truncate silently.
+                            fps=16,
+                            chunk_length=_CHUNK_LENGTH,
+                            # Policy-only task mode. "joint" would randomly pick
+                            # forward_dynamics/inverse_dynamics/policy per sample (multi-task),
+                            # which dilutes each per-task loss by ~1/3.
+                            mode="policy",
+                            # Prepend the current absolute qpos14 as conditioning action row 0.
+                            use_state=True,
+                            # Raw absolute joint targets; no stats file anywhere.
+                            action_normalization=None,
+                            viewpoint="concat_view",  # single pre-composed 320x360 mosaic
+                            # Train on all episodes: the protocol holds out no demos.
+                            split="full",
+                            # 640x640 bucket; scaling_ratio caps at 1.0 so the 320x360
+                            # mosaic arrives at native scale (padded, never resampled).
+                            resolution="480",
+                            # No crop/jitter: it would break the frozen mosaic geometry
+                            # that the eval-time policy server reproduces.
+                            use_image_augmentation=False,
+                            iterable_shuffle=True,  # rank x worker episode-shuffle stream
+                            episode_shuffle_seed=42,
+                            max_action_dim="${model.config.max_action_dim}",
+                            cfg_dropout_rate=0.1,
+                            tokenizer_config="${model.config.vlm_config.tokenizer}",
+                            format_prompt_as_json=True,
+                        ),
+                    ),
+                ),
+            ),
+        ),
+        dataloader_val=None,
+        upload_reproducible_setup=False,
+    ),
+    flags={"allow_objects": True},
+)
+
+
+for _item in [action_policy_robotwin_edge]:
+    _name = [k for k, v in globals().items() if v is _item][0]
+    cs.store(group="experiment", package="_global_", name=_name, node=_item)

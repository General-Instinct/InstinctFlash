+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: OpenMDW-1.1
+
+"""HTTP inference server for the RoboTwin 2.0 (aloha-agilex) Cosmos3 action policy.
+
+This is a fork of two shipped servers, taking the model path from one and the
+transport from the other:
+
+- **Model path** from ``action_policy_server_robolab.py``: the request is turned
+  into a raw dataset-style sample and pushed through the *training-time*
+  ``ActionTransformPipeline`` (resize/reflection-pad, viewpoint/duration/resolution
+  caption augmentation or the JSON prompt formatter, sequence-plan construction,
+  action padding + ``action_processing_record``).  That is the only way to keep
+  serve-time preprocessing byte-identical to train-time preprocessing.  Like
+  robolab, this server applies **no action denormalization** — the RoboTwin pilot
+  is pre-registered with ``action_normalization = None``, so there is no stats
+  file anywhere and nothing to invert.
+- **Transport** from ``action_policy_server_libero.py``: plain ``ThreadingHTTPServer``
+  + JSON + base64 PNG.  RoboTwin 2.0 runs in a python 3.10 / torch 2.4 venv that
+  cannot import ``openpi-client``, so robolab's msgpack WebSocket protocol is not
+  usable from the eval harness.
+
+Differences from robolab that are **pre-registered contract**, not preference
+(see ``InstinctWM/docs/robotwin_pilot_protocol.md``):
+
+- 14-D absolute joint state/action, layout ``[left_arm(6), left_gripper,
+  right_arm(6), right_gripper]``.  Robolab hard-codes 7 for DROID's single-arm
+  ``joint_position`` plus a separate 1-D gripper; that is replaced by a single
+  ``qpos14`` vector here.
+- **No gripper flip.**  Robolab applies ``1.0 - g`` on input
+  (``gripper_position = 1.0 - _ensure_gripper_array(...)``) and again on output
+  (``action_np[:, -1] = 1.0 - action_np[:, -1]``).  Those are a DROID convention.
+  RoboTwin's native convention is ``1.0 = open`` on both sides, so both flips are
+  removed.  Outside this docstring there is no gripper arithmetic anywhere in this
+  file: ``qpos14`` goes into action row 0 verbatim and the model's action rows come
+  back out verbatim.
+- ``fps`` is 16 everywhere (the true rate is 16.67 Hz, but ``conditioning_fps`` is
+  cast to ``long`` downstream, so a non-integer would silently truncate).
+- ``use_state=True``: the current absolute state is prepended as action row 0 and
+  is a *conditioning* row, so the model sees 17 action rows / 17 video frames for a
+  chunk of 16, and row 0 is dropped from the reply.
+
+Endpoints:
+
+- ``POST /predict``            one observation -> one action chunk + timing
+- ``POST /predict_batch``      N observations -> N action chunks (one diffusion forward)
+- ``GET  /info``               resolved runtime config
+- ``POST /notify_next_episode`` reset per-episode server state (seed stream, counters)
+- ``GET  /``                   health check
+
+Timing instrumentation is a first-class product requirement here, not a nicety:
+we already measured ``t_chunk(ms) = 1029 + 29.06 x denoise_steps`` on H100 at
+chunk 16, i.e. ~90% of latency at 4 steps is fixed overhead.  The per-request
+breakdown returned under ``"timing"`` is how we find out *which* fixed component
+to attack.  See ``_ModelTimingProbe`` for how the sub-timers are collected and
+``_build_timing_payload`` for the additivity contract (the exclusive components
+sum to ``total_ms`` up to ``residual_ms``).
+
+Example (guardrails default OFF; ``nvidia/Cosmos-Guardrail1`` is a gated repo):
+
+  cd /home/ubuntu/cosmos-framework && source .venv/bin/activate
+  PYTHONPATH=. python -m cosmos_framework.scripts.action_policy_server_robotwin \
+    --checkpoint-path /path/to/train-output/model \
+    --config-file /path/to/train-output/config.yaml \
+    --port 8000 --num-steps 4 --guidance 1.0
+"""
+
+# Initialize the script runtime before any cosmos-framework imports, mirroring
+# both upstream servers.
+from cosmos_framework.inference.common.init import init_script
+
+init_script()
+
+import base64
+import binascii
+import datetime
+import io
+import json
+import statistics
+import threading
+import time
+import traceback
+from dataclasses import dataclass, field
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from typing import Any, Callable, Literal
+
+import numpy as np
+import pydantic
+import torch
+import tyro
+from PIL import Image
+
+from cosmos_framework.data.generator.action.domain_utils import get_domain_id
+from cosmos_framework.data.generator.action.transforms import ActionTransformPipeline
+from cosmos_framework.data.generator.joint_dataloader import IterativeJointDataLoader
+from cosmos_framework.inference.args import OmniSetupArgs, OmniSetupOverrides
+from cosmos_framework.inference.common.args import ConfigFileType, ConfigOverrides, tyro_cli
+from cosmos_framework.inference.common.config import deserialize_config, deserialize_config_dict, load_config
+from cosmos_framework.inference.common.init import init_output_dir
+from cosmos_framework.inference.inference import OmniInference
+from cosmos_framework.scripts.action_policy_server_utils import (
+    DEFAULT_FALLBACK_OUTPUT_DIR,
+    disable_runtime_ema_for_frozen_config,
+    get_local_ip,
+    maybe_init_distributed,
+)
+from cosmos_framework.utils import log
+from cosmos_framework.utils.lazy_config import instantiate
+
+# ---------------------------------------------------------------------------
+# Frozen contract constants (other agents depend on these exact values)
+# ---------------------------------------------------------------------------
+
+ROBOTWIN_DOMAIN_NAME = "robotwin_aloha_agilex"
+"""Cosmos domain name string for the RoboTwin aloha-agilex embodiment."""
+
+ROBOTWIN_DOMAIN_ID_FALLBACK = 11
+"""Pre-registered domain id.  Only used if ``domain_utils.py`` does not know the
+domain name yet (that file is owned by another agent).  Never invent a different id."""
+
+ROBOTWIN_RAW_ACTION_DIM = 14
+"""[left_arm(6), left_gripper, right_arm(6), right_gripper] absolute joint positions."""
+
+_DEFAULT_ACTION_CHUNK_SIZE = 16
+_DEFAULT_CONDITIONING_FPS = 16.0
+_DEFAULT_RESOLUTION = "480"
+_DEFAULT_ROBOTWIN_OUTPUT_DIR = DEFAULT_FALLBACK_OUTPUT_DIR / "robotwin"
+_MOSAIC_H = 360
+_MOSAIC_W = 320
+
+# The dataset module (owned by another agent) exports the canonical view
+# description.  Import it so train and serve share one string; fall back to a
+# verbatim copy if the module does not exist yet.  A mismatch between these two
+# strings is a silent train/serve prompt skew, so /info reports which one is live.
+# Kept byte-identical to robotwin_lerobot_dataset.ROBOTWIN_VIEW_DESC; asserted equal
+# below whenever the real module is importable, so drift is caught at startup.
+_FALLBACK_ROBOTWIN_VIEW_DESC = (
+    "The top row is a third-person head-camera view of the dual-arm robot. "
+    "The bottom row contains two horizontally concatenated wrist-camera views, left arm then right arm."
+)
+try:  # pragma: no cover - depends on a module owned by another agent
+    from cosmos_framework.data.generator.action.datasets.robotwin_lerobot_dataset import (  # type: ignore[import-not-found]
+        ROBOTWIN_VIEW_DESC,
+    )
+
+    _VIEW_DESC_SOURCE = "robotwin_lerobot_dataset.ROBOTWIN_VIEW_DESC"
+    if ROBOTWIN_VIEW_DESC != _FALLBACK_ROBOTWIN_VIEW_DESC:
+        # The imported value always wins (it is what training used); this only warns
+        # that the local copy has gone stale and would skew the prompt if it were used.
+        log.warning(
+            "[robotwin-policy-server] _FALLBACK_ROBOTWIN_VIEW_DESC has drifted from the dataset module's "
+            "ROBOTWIN_VIEW_DESC. Using the imported value; update the fallback copy in this file."
+        )
+except Exception as _view_desc_exc:  # noqa: BLE001 - any import failure must not kill serving
+    ROBOTWIN_VIEW_DESC = _FALLBACK_ROBOTWIN_VIEW_DESC
+    _VIEW_DESC_SOURCE = f"module-level fallback ({type(_view_desc_exc).__name__}: {_view_desc_exc})"
+
+
+# ---------------------------------------------------------------------------
+# Checkpoint / training-config resolution (ported from robolab)
+# ---------------------------------------------------------------------------
+
+
+def _load_checkpoint_metadata(checkpoint_path: str) -> dict[str, Any] | None:
+    if "://" in checkpoint_path:
+        return None
+    checkpoint_dir = Path(checkpoint_path).expanduser().absolute()
+    if (checkpoint_dir / "model").is_dir():
+        checkpoint_dir = checkpoint_dir / "model"
+    metadata_path = checkpoint_dir / "checkpoint.json"
+    if not metadata_path.exists():
+        return None
+    return deserialize_config_dict(metadata_path)
+
+
+def _load_training_config_from_metadata(metadata: dict[str, Any]) -> Any | None:
+    config_file = metadata.get("config_file")
+    if not isinstance(config_file, str) or not config_file:
+        return None
+    config_overrides = ConfigOverrides(
+        config_file=config_file,
+        experiment=str(metadata.get("experiment", "")),
+        experiment_overrides=list(metadata.get("experiment_overrides", [])),
+    )
+    config_args = config_overrides.build_config()
+    if config_args.config_file_type == ConfigFileType.MODULE:
+        return load_config(config_args.config_file, config_args.experiment, overrides=config_args.experiment_overrides)
+    return deserialize_config(Path(config_args.config_file))
+
+
+def _load_training_config(setup_args: OmniSetupArgs, checkpoint_path: str) -> Any | None:
+    """Best-effort load of the training config so the serve-time transform is the
+    train-time transform.  Returns ``None`` when only a consolidated HF export is
+    available (then a default ``ActionTransformPipeline`` is used)."""
+    metadata = _load_checkpoint_metadata(checkpoint_path)
+    if metadata is not None:
+        try:
+            config = _load_training_config_from_metadata(metadata)
+        except Exception as exc:  # noqa: BLE001
+            log.warning(f"[robotwin-policy-server] could not load checkpoint metadata config for transforms: {exc}")
+            config = None
+        if config is not None:
+            return config
+
+    if setup_args.config_file_type == ConfigFileType.MODULE and not setup_args.experiment:
+        return None
+
+    try:
+        return setup_args.load_config()
+    except Exception as exc:  # noqa: BLE001
+        log.warning(f"[robotwin-policy-server] could not load training config for transforms: {exc}")
+        return None
+
+
+def _walk_config_nodes(node: Any, depth: int = 0) -> Any:
+    """Yield every mapping node in a (possibly omegaconf) config tree."""
+    if depth > 24:
+        return
+    try:
+        if isinstance(node, (list, tuple)):
+            for item in node:
+                yield from _walk_config_nodes(item, depth + 1)
+            return
+        keys = list(node.keys())  # dict, DictConfig, LazyDict all support this
+    except (AttributeError, TypeError):
+        return
+    yield node
+    for key in keys:
+        try:
+            child = node[key]
+        except Exception:  # noqa: BLE001 - unresolvable interpolations must not abort the walk
+            continue
+        yield from _walk_config_nodes(child, depth + 1)
+
+
+def _dataloader_train_node(training_config: Any) -> Any:
+    """Return ``config.dataloader_train`` (item or attribute access), else the config.
+
+    Scoping the search to the dataloader subtree keeps the walk away from the model
+    /network config, which can hold arbitrary objects."""
+    for getter in (lambda c: c["dataloader_train"], lambda c: getattr(c, "dataloader_train")):
+        try:
+            node = getter(training_config)
+        except Exception:  # noqa: BLE001
+            continue
+        if node is not None:
+            return node
+    return training_config
+
+
+def _transform_parity(t: Any) -> dict[str, Any]:
+    """Everything about the serve-time transform that has to match training.
+
+    Read off the live object: `prompt_json_formatter is not None` IS
+    format_prompt_as_json, whatever the config said it should be.
+    """
+    if t is None:
+        return {"error": "no transform on this server"}
+    return {
+        "format_prompt_as_json": getattr(t, "prompt_json_formatter", None) is not None,
+        "append_viewpoint_info": getattr(t, "viewpoint_augmentor", None) is not None,
+        "append_duration_fps_timestamps": getattr(t, "duration_fps_augmentor", None) is not None,
+        "append_resolution_info": getattr(t, "resolution_info_augmentor", None) is not None,
+        "append_idle_frames": getattr(t, "idle_frames_augmentor", None) is not None,
+        "max_action_dim": getattr(t, "max_action_dim", None),
+        "action_channel_masking": getattr(t, "action_channel_masking", None),
+        "video_temporal_downsample": getattr(t, "video_temporal_downsample", None),
+        "caption_key": getattr(t, "caption_key", None),
+        "transform_class": type(t).__name__,
+    }
+
+
+def _find_action_dataset_node(training_config: Any) -> Any | None:
+    """Locate the training action-dataset config node.
+
+    Robolab's introspection assumed one specific nesting
+    (``dataloader_train.dataloaders.action_data.dataloader.dataset.list_of_datasets[0]``).
+    The RoboTwin experiment config uses
+    ``dataloader_train.dataloader.datasets.<name>.dataset`` with every knob on the
+    dataset factory call itself, so a structural lookup misses it and silently falls
+    back to a *different* prompt format.  Searching by content, not by path, works for
+    either layout."""
+    best = None
+    for node in _walk_config_nodes(_dataloader_train_node(training_config)):
+        try:
+            if "chunk_length" not in node:
+                continue
+        except Exception:  # noqa: BLE001
+            continue
+        target = ""
+        try:
+            target = str(node.get("_target_", "") or "")
+        except Exception:  # noqa: BLE001
+            target = ""
+        if "robotwin" in target.lower():
+            return node
+        if best is None:
+            best = node
+    return best
+
+
+def _config_value(node: Any, key: str, default: Any = None) -> Any:
+    """Read one config value, tolerating unresolvable interpolations."""
+    try:
+        if key not in node:
+            return default
+        value = node[key]
+    except Exception:  # noqa: BLE001
+        return default
+    if value is None:
+        return default
+    try:
+        # Unwrap omegaconf scalars / interpolations that resolve to primitives.
+        if isinstance(value, (bool, int, float, str)):
+            return value
+        return default if hasattr(value, "keys") or isinstance(value, (list, tuple)) else value
+    except Exception:  # noqa: BLE001
+        return default
+
+
+def _resolve_domain_id(domain_name: str) -> int:
+    """Resolve a domain id, tolerating a ``domain_utils.py`` that has not been
+    updated yet (that file is owned by another agent).
+
+    Only ``robotwin_aloha_agilex`` gets a fallback, and only to its
+    pre-registered id 11.  Every other unknown name still raises."""
+    try:
+        return get_domain_id(domain_name)
+    except KeyError:
+        if domain_name.lower().strip() == ROBOTWIN_DOMAIN_NAME:
+            log.warning(
+                f"[robotwin-policy-server] {ROBOTWIN_DOMAIN_NAME!r} is not registered in domain_utils.py yet; "
+                f"using the pre-registered domain id {ROBOTWIN_DOMAIN_ID_FALLBACK}. "
+                "Training MUST use the same id or the action modality embedding will not match."
+            )
+            return ROBOTWIN_DOMAIN_ID_FALLBACK
+        raise
+

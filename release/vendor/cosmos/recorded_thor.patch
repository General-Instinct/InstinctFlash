+class RobotwinServerArgs(pydantic.BaseModel):
+    model_config = pydantic.ConfigDict(extra="forbid", use_attribute_docstrings=True)
+
+    # ----- checkpoint / config ------------------------------------------------
+    checkpoint_path: str = ""
+    """Consolidated safetensors checkpoint directory (from cosmos_framework.scripts.export_model),
+    a registered checkpoint name, or a DCP path when --config-file is also given."""
+    config_file: str | None = None
+    """Hydra config store module (.py), config yaml, or HF model json. Required for
+    direct DCP checkpoint loading; inferred from the checkpoint directory otherwise."""
+    experiment: str | None = None
+    """Hydra experiment name, e.g. robotwin_aloha_agilex_edge_policy. Needed with a .py --config-file."""
+    experiment_overrides: list[str] = pydantic.Field(default_factory=list)
+    """Hydra experiment overrides forwarded to OmniSetup."""
+    credential_path: str | None = None
+    """Object-store credential path for s3:// DCP checkpoints."""
+    use_ema_weights: bool = True
+    """Load net_ema when the checkpoint has EMA weights (matches the shipped eval default)."""
+
+    # ----- InstinctWM: expose the execution knobs this server did not forward --------
+    # `use_cuda_graphs` and `compiled_region` are top-level OmniSetupOverrides fields, NOT
+    # part of the `model.config.compile.*` namespace that --experiment-overrides reaches. The
+    # shipped build_setup_args() forwards neither, so on this server CUDA graphs could not be
+    # turned on at all -- and an --experiment-overrides attempt at
+    # `model.config.compile.use_cuda_graphs=True` is silently discarded by the inference-side
+    # config, which then reports use_cuda_graphs=False. That cost us a whole void experiment
+    # (results/invalid/p2_bitexact_INVALID_inert_overrides.json), so both are surfaced in
+    # /info as well: a knob that cannot be observed is a knob that cannot be trusted.
+    nfe_rungs: list[int] = pydantic.Field(default_factory=list)
+    """InstinctWM: NFE values a request may select via the `num_steps` field.
+
+    Empty means only --num-steps is servable, i.e. the shipped behaviour where the step count
+    is fixed for the lifetime of the process. That makes L3's deadline-derived step count
+    unimplementable: choosing how much to think per chunk needs several rungs behind ONE
+    loaded model, not one server per rung.
+
+    A request asking for a rung outside this set is REFUSED rather than served, because an
+    uncaptured shape would pay the ~33 s capture cliff mid-episode. Same rule as
+    instinctwm.execution.ShapeManifest.require.
+    """
+    use_cuda_graphs: bool = False
+    """Enable torch.compile(mode="reduce-overhead") CUDA-graph capture for inference."""
+    compiled_region: Literal["all", "language"] = "all"
+    """Which region torch.compile covers. "all" also compiles encode/decode."""
+    cudagraphs_via_options: bool = False
+    """InstinctWM: request cudagraphs through inductor options and leave torch.compile's mode
+    at the default, instead of mode="reduce-overhead" which also changes kernel selection.
+    Exists to isolate whether the measured 1.72e-02 action delta comes from CAPTURE or from
+    the MODE -- capture alone should be numerically neutral."""
+    compile_dynamic: bool = True
+    """torch.compile(dynamic=...). Forwarded so it can be varied independently of capture; the
+    shipped server hardcoded the setup default and it could not be isolated."""
+
+    # ----- HTTP ---------------------------------------------------------------
+    host: str = "0.0.0.0"
+    """HTTP host to bind."""
+    port: int = 8000
+    """HTTP port to bind."""
+    http_400_on_error: bool = False
+    """Return HTTP 400 on inference errors. Default is HTTP 200 with an empty action list."""
+
+    # ----- sampling -----------------------------------------------------------
+    sampler: Literal["unipc", "edm"] = "unipc"
+    """Diffusion sampler used by OmniInference."""
+    num_steps: int = 4
+    """Number of denoising steps. Accuracy must be published at every step count we quote a latency for."""
+    guidance: float = 1.0
+    """Guidance scale. 1.0 keeps NFE == num_steps; anything else doubles the network forwards."""
+    shift: float = 5.0
+    """UniPC sampler shift."""
+    seed: int = 0
+    """Base generation seed used to initialize the per-request RNG."""
+    deterministic_seed: bool = True
+    """Use --seed for every request. Set --no-deterministic-seed to advance an RNG per request."""
+
+    # ----- action / observation contract --------------------------------------
+    domain_name: str = ROBOTWIN_DOMAIN_NAME
+    """Default action domain name; a request may override it per call."""
+    action_dim: int = ROBOTWIN_RAW_ACTION_DIM
+    """Raw (unpadded) action width. 14 for aloha-agilex qpos."""
+    action_chunk_size: int | None = _DEFAULT_ACTION_CHUNK_SIZE
+    """Predicted action steps per chunk. Falls back to the training config's chunk_length."""
+    conditioning_fps: float | None = _DEFAULT_CONDITIONING_FPS
+    """Conditioning FPS. Cast to long downstream, so keep it an integer (16, not 16.67)."""
+    resolution: str | None = None
+    """Action transform resolution tier. Default None = take it from the training config
+    (setting it explicitly OVERRIDES training, which is a silent train/serve skew if wrong).
+    Falls back to '480' with a warning when no training config is reachable."""
+    use_state: bool = True
+    """Prepend the current absolute state as action row 0 (a conditioning row)."""
+    history_length: int = 1
+    """Leading action rows that are conditioning and must be trimmed from the reply.
+    With --use-state and no extra history this is 1."""
+    format_prompt_as_json: bool | None = None
+    """Serve prompts as structured JSON. None follows the training config."""
+    expected_image_height: int | None = _MOSAIC_H
+    """Reject observations whose mosaic height differs (frozen geometry guard). None disables."""
+    expected_image_width: int | None = _MOSAIC_W
+    """Reject observations whose mosaic width differs (frozen geometry guard). None disables."""
+
+    # ----- guardrails ---------------------------------------------------------
+    guardrails: bool = False
+    """Cosmos text/video guardrails. Default OFF: nvidia/Cosmos-Guardrail1 is a GATED repo,
+    so leaving this on kills startup. Guardrails filter text/video content and are irrelevant
+    to robot action latency and accuracy."""
+
+    # ----- timing / debug -----------------------------------------------------
+    sync_timing: bool = True
+    """torch.cuda.synchronize() at each instrumented boundary so the breakdown is truthful.
+    --no-sync-timing gives the fastest wall time but a breakdown that must not be trusted per-component."""
+    reset_peak_memory_per_request: bool = False
+    """Reset CUDA peak-memory stats at each request so max_memory_allocated is per-request
+    instead of process-lifetime."""
+    decode_video: bool = False
+    """Also decode and return the predicted rollout as base64 PNG frames (debug only, slow)."""
+    dump_dir: Path | None = None
+    """Dump observations, actions and timing under this directory for offline debugging."""
+    dump_every: int = 1
+    """Dump every N-th request (only used with --dump-dir)."""
+    output_dir: Path | None = None
+    """OmniInference output directory. Defaults to --dump-dir, else /tmp/cosmos3_action_server/robotwin."""
+
+    def build_setup_args(self) -> OmniSetupArgs:
+        if not self.checkpoint_path:
+            raise ValueError("--checkpoint-path is required")
+        setup_overrides: dict[str, Any] = {
+            "checkpoint_path": self.checkpoint_path,
+            "output_dir": self.output_dir or self.dump_dir or _DEFAULT_ROBOTWIN_OUTPUT_DIR,
+            "sampler": self.sampler,
+            "use_ema_weights": bool(self.use_ema_weights),
+            # Proper flag instead of the monkeypatch in InstinctWM/tools/serve_cosmos_policy.py:
+            # OmniSetupOverrides inherits GuardrailOverrides.guardrails (default True), and
+            # OmniInference.create only builds GuardrailRunners when it is True.
+            "guardrails": bool(self.guardrails),
+            # InstinctWM: the two knobs the shipped server dropped on the floor.
+            "use_cuda_graphs": bool(self.use_cuda_graphs),
+            "compiled_region": self.compiled_region,
+            "cudagraphs_via_options": bool(self.cudagraphs_via_options),
+            "compile_dynamic": bool(self.compile_dynamic),
+        }
+        if self.config_file is not None:
+            setup_overrides["config_file"] = self.config_file
+        if self.experiment is not None:
+            setup_overrides["experiment"] = self.experiment
+        if self.experiment_overrides:
+            setup_overrides["experiment_overrides"] = list(self.experiment_overrides)
+        if self.credential_path is not None:
+            setup_overrides["credential_path"] = self.credential_path
+        overrides = OmniSetupOverrides.model_validate(setup_overrides)
+        setup_args = overrides.build_setup()
+        init_output_dir(setup_args.output_dir)
+        return disable_runtime_ema_for_frozen_config(setup_args)
+
+
+@dataclass(frozen=True)
+class RobotwinPolicyConfig:
+    """Resolved runtime configuration snapshot."""
+
+    checkpoint_path: str
+    config_file: str
+    experiment_name: str
+    domain_name: str
+    action_dim: int
+    action_chunk_size: int
+    conditioning_fps: float
+    resolution: str | None
+    use_state: bool
+    history_length: int
+    nfe_rungs: tuple[int, ...]
+    num_steps: int
+    guidance: float
+    shift: float
+    seed: int
+    deterministic_seed: bool
+    decode_video: bool
+    dump_dir: Path | None
+    dump_every: int
+    http_400_on_error: bool
+    sync_timing: bool
+    reset_peak_memory_per_request: bool
+    guardrails: bool
+    expected_image_height: int | None
+    expected_image_width: int | None
+
+
+# ---------------------------------------------------------------------------
+# Service
+# ---------------------------------------------------------------------------
+
+
+class RobotwinPolicyService:
+    def __init__(self, args: RobotwinServerArgs) -> None:
+        if not torch.cuda.is_available():
+            raise RuntimeError("CUDA is required for OmniMoTModel inference in this repo.")
+        maybe_init_distributed()
+
+        setup_args = args.build_setup_args()
+        log.info(
+            f"[robotwin-policy-server] loading model: checkpoint_path={setup_args.checkpoint_path!r} "
+            f"config_file={setup_args.config_file!r} ({setup_args.config_file_type}) "
+            f"experiment={setup_args.experiment!r} guardrails={bool(args.guardrails)}"
+        )
+        pipe = OmniInference.create(setup_args)
+        self.pipe: OmniInference = pipe
+        self.model = pipe.model
+        self.model.eval()
+        assert isinstance(pipe.setup_args, OmniSetupArgs)
+        self.setup_args: OmniSetupArgs = pipe.setup_args
+
+        training_config = _load_training_config(self.setup_args, setup_args.checkpoint_path)
+        self._transform, inferred = self._build_transform(training_config, args)
+
+        if args.resolution is not None:
+            resolution = args.resolution
+            log.warning(
+                f"[robotwin-policy-server] --resolution={resolution!r} was given explicitly and OVERRIDES the "
+                "training config. Only do this deliberately; a mismatch with training is a silent skew."
+            )
+        elif inferred.get("resolution") is not None:
+            resolution = str(inferred["resolution"])
+            log.info(f"[robotwin-policy-server] resolution={resolution!r} taken from the training config")
+        else:
+            resolution = _DEFAULT_RESOLUTION
+            log.warning(
+                f"[robotwin-policy-server] no resolution in the training config; falling back to "
+                f"{_DEFAULT_RESOLUTION!r}. Verify this matches training or pass --resolution."
+            )
+
+        conditioning_fps = float(args.conditioning_fps or inferred.get("conditioning_fps") or _DEFAULT_CONDITIONING_FPS)
+        if conditioning_fps != float(int(conditioning_fps)):
+            log.warning(
+                f"[robotwin-policy-server] conditioning_fps={conditioning_fps} is not an integer; it is cast to "
+                f"long downstream and would silently truncate to {int(conditioning_fps)}. "
+                "The RoboTwin pilot pre-registers 16."
+            )
+        self.cfg = RobotwinPolicyConfig(
+            checkpoint_path=self.setup_args.checkpoint_path,
+            config_file=str(self.setup_args.config_file),
+            experiment_name=self.setup_args.experiment or "",
+            domain_name=args.domain_name,
+            action_dim=int(args.action_dim),
+            action_chunk_size=int(
+                args.action_chunk_size or inferred.get("action_chunk_size") or _DEFAULT_ACTION_CHUNK_SIZE
+            ),
+            conditioning_fps=conditioning_fps,
+            resolution=resolution,
+            use_state=bool(args.use_state),
+            history_length=int(args.history_length),
+            num_steps=int(args.num_steps),
+            # Always include --num-steps so the default rung is servable even if the caller
+            # passed no explicit list.
+            nfe_rungs=tuple(sorted({int(args.num_steps), *(int(n) for n in args.nfe_rungs)})),
+            guidance=float(args.guidance),
+            shift=float(args.shift),
+            seed=int(args.seed),
+            deterministic_seed=bool(args.deterministic_seed),
+            decode_video=bool(args.decode_video),
+            dump_dir=args.dump_dir,
+            dump_every=int(args.dump_every),
+            http_400_on_error=bool(args.http_400_on_error),
+            sync_timing=bool(args.sync_timing),
+            reset_peak_memory_per_request=bool(args.reset_peak_memory_per_request),
+            guardrails=bool(args.guardrails),
+            expected_image_height=args.expected_image_height,
+            expected_image_width=args.expected_image_width,
+        )
+        if self.cfg.history_length < (1 if self.cfg.use_state else 0):
+            raise ValueError("--history-length must be >= 1 when --use-state is true")
+        if self.cfg.action_dim <= 0:
+            raise ValueError("--action-dim must be positive")
+
+        # Resolve the domain id once so a missing registration fails at startup,
+        # not on the first request in the middle of an eval.
+        self._domain_id_cache: dict[str, int] = {}
+        self.domain_id = self._domain_id(self.cfg.domain_name)
+
+        self._lock = threading.Lock()
+        self._req_id_lock = threading.Lock()
+        self._req_id = 0
+        self._episode_index = 0
+        self._requests_this_episode = 0
+        self._rng = np.random.default_rng(self.cfg.seed)
+        self.probe = _ModelTimingProbe(self.model, sync=self.cfg.sync_timing)
+
+        log.info(
+            f"[robotwin-policy-server] ready domain={self.cfg.domain_name!r} domain_id={self.domain_id} "
+            f"action_dim={self.cfg.action_dim} chunk={self.cfg.action_chunk_size} "
+            f"use_state={self.cfg.use_state} history={self.cfg.history_length} "
+            f"resolution={self.cfg.resolution!r} fps={self.cfg.conditioning_fps} "
+            f"steps={self.cfg.num_steps} guidance={self.cfg.guidance} shift={self.cfg.shift} "
+            f"sampler={self.setup_args.sampler} action_normalization=None (no denormalization) "
+            f"gripper=RoboTwin-native (no 1-g flip) view_desc_source={_VIEW_DESC_SOURCE!r} "
+            f"sync_timing={self.cfg.sync_timing}"
+        )
+
+    # ------------------------------------------------------------------
+    # Setup helpers
+    # ------------------------------------------------------------------
+
+    def _domain_id(self, domain_name: str) -> int:
+        cached = self._domain_id_cache.get(domain_name)
+        if cached is None:
+            cached = _resolve_domain_id(domain_name)
+            self._domain_id_cache[domain_name] = cached
+        return cached
+
+    def _build_transform(self, training_config: Any | None, args: RobotwinServerArgs) -> tuple[Any, dict[str, Any]]:
+        """Return the *training-time* transform pipeline plus values inferred from
+        the training config.  Ported from robolab: reusing the training transform is
+        what keeps serve-time preprocessing identical to train-time preprocessing."""
+        inferred: dict[str, Any] = {}
+        model_max_action_dim = getattr(getattr(self.model, "config", None), "max_action_dim", None)
+        max_action_dim = int(model_max_action_dim) if isinstance(model_max_action_dim, int) else 64
+
+        try:
+            dataset_config = (
+                training_config.dataloader_train.dataloaders.action_data.dataloader.dataset
+                if training_config is not None
+                else None
+            )
+            dataset_entry = dataset_config.list_of_datasets[0] if dataset_config is not None else None
+            action_dataset_config = dataset_entry.dataset if dataset_entry is not None else None
+        except (AttributeError, IndexError, TypeError):
+            dataset_config = None
+            dataset_entry = None
+            action_dataset_config = None
+
+        if dataset_config is None or dataset_entry is None:
+            # Second path: the RoboTwin experiment config puts every transform knob on
+            # the dataset factory call (``...dataloader.datasets.<name>.dataset``) and
+            # has no wrapper object to instantiate, so rebuild an equivalent pipeline
+            # from the config values instead of guessing defaults.
+            return self._rebuild_transform_from_config_values(
+                training_config, args, max_action_dim=max_action_dim, inferred=inferred
+            )
+
+        if action_dataset_config is not None:
+            chunk_length = getattr(action_dataset_config, "chunk_length", None)
+            if isinstance(chunk_length, int):
+                inferred["action_chunk_size"] = chunk_length
+            fps = getattr(action_dataset_config, "fps", None)
+            if isinstance(fps, (int, float)):
+                inferred["conditioning_fps"] = float(fps)
+
+        if args.resolution is not None:
+            dataset_entry.resolution = args.resolution
+        else:
+            inferred_resolution = dataset_entry.resolution
+            if inferred_resolution is None:
+                inferred_resolution = dataset_config.resolution
+            if inferred_resolution is not None:
+                inferred["resolution"] = str(inferred_resolution)
+
+        if dataset_config.cfg_dropout_rate != 0.0:
+            dataset_config.cfg_dropout_rate = 0.0
+
+        # Swap the real dataset for a stub: we only want the wrapper's transform.
+        dataset_entry.dataset = {"_target_": f"{__name__}._DummyDataset"}
+
+        if args.format_prompt_as_json is not None:
+            dataset_config.format_prompt_as_json = bool(args.format_prompt_as_json)
+
+        wrapped_dataset = instantiate(dataset_config)
+        return wrapped_dataset.transform, inferred
+
+    def _rebuild_transform_from_config_values(
+        self,
+        training_config: Any | None,
+        args: RobotwinServerArgs,
+        *,
+        max_action_dim: int,
+        inferred: dict[str, Any],
+    ) -> tuple[Any, dict[str, Any]]:
+        """Reconstruct the training ``ActionTransformPipeline`` from config values.
+
+        Used when the training config's dataset node cannot be instantiated without
+        the data root (the RoboTwin factory builds its dataset and transform in one
+        call).  ``tokenizer_config`` is deliberately left ``None``: inference
+        tokenizes ``ai_caption`` inside the model, and skipping the in-transform
+        tokenizer also removes any chance of the training CFG caption dropout firing
+        on a served request."""
+        node = _find_action_dataset_node(training_config) if training_config is not None else None
+        if node is None:
+            log.warning(
+                "[robotwin-policy-server] no training action dataset config found; using a default "
+                f"ActionTransformPipeline (max_action_dim={max_action_dim}, "
+                f"format_prompt_as_json={bool(args.format_prompt_as_json)}). "
+                "Serve-time prompt format is only guaranteed to match training when the training "
+                "config is reachable (pass --config-file/--experiment)."
+            )
+            return (
+                ActionTransformPipeline(
+                    max_action_dim=max_action_dim,
+                    cfg_dropout_rate=0.0,
+                    format_prompt_as_json=bool(args.format_prompt_as_json),
+                ),
+                inferred,
+            )
+
+        chunk_length = _config_value(node, "chunk_length")
+        if isinstance(chunk_length, int):
+            inferred["action_chunk_size"] = chunk_length
+        fps = _config_value(node, "fps")
+        if isinstance(fps, (int, float)):
+            inferred["conditioning_fps"] = float(fps)
+        resolution = _config_value(node, "resolution")
+        if resolution is not None:
+            inferred["resolution"] = str(resolution)
+        node_max_action_dim = _config_value(node, "max_action_dim")
+        if isinstance(node_max_action_dim, int):
+            max_action_dim = node_max_action_dim
+
+        train_format_json = bool(_config_value(node, "format_prompt_as_json", True))
+        format_prompt_as_json = (
+            bool(args.format_prompt_as_json) if args.format_prompt_as_json is not None else train_format_json
+        )
+        if args.format_prompt_as_json is not None and bool(args.format_prompt_as_json) != train_format_json:
+            log.warning(
+                f"[robotwin-policy-server] --format-prompt-as-json={format_prompt_as_json} disagrees with the "
+                f"training config ({train_format_json}). The served prompt format will NOT match training."
+            )
+
+        train_use_state = _config_value(node, "use_state")
+        if isinstance(train_use_state, bool) and train_use_state != bool(args.use_state):
+            log.warning(
+                f"[robotwin-policy-server] --use-state={bool(args.use_state)} disagrees with the training config "
+                f"(use_state={train_use_state}). Action row 0 conditioning will not match training."
+            )
+
+        pipeline = ActionTransformPipeline(
+            tokenizer_config=None,
+            cfg_dropout_rate=0.0,
+            max_action_dim=max_action_dim,
+            append_viewpoint_info=bool(_config_value(node, "append_viewpoint_info", True)),
+            append_duration_fps_timestamps=bool(_config_value(node, "append_duration_fps_timestamps", True)),
+            append_resolution_info=bool(_config_value(node, "append_resolution_info", True)),
+            append_idle_frames=bool(_config_value(node, "append_idle_frames", False)),
+            format_prompt_as_json=format_prompt_as_json,
+        )
+        log.info(
+            "[robotwin-policy-server] rebuilt the training ActionTransformPipeline from config values: "
+            f"max_action_dim={max_action_dim} format_prompt_as_json={format_prompt_as_json} "
+            f"chunk_length={inferred.get('action_chunk_size')} fps={inferred.get('conditioning_fps')} "
+            f"resolution={inferred.get('resolution')} (tokenizer_config=None: the model tokenizes ai_caption)"
+        )
+        return pipeline, inferred
+
+    def _next_seed(self) -> int:
+        if self.cfg.deterministic_seed:
+            return self.cfg.seed
+        return int(self._rng.integers(0, 2**31))
+
+    def _should_dump(self, request_id: int) -> bool:
+        if self.cfg.dump_dir is None:
+            return False
+        n = int(self.cfg.dump_every)
+        if n <= 0:
+            return False
+        return request_id == 1 or (request_id % n == 0)
+
+    # ------------------------------------------------------------------
+    # /info and /notify_next_episode
+    # ------------------------------------------------------------------
+
+    def get_info(self) -> dict[str, Any]:
+        return {
+            "server": "action_policy_server_robotwin",
+            "run_name": self.cfg.experiment_name,
+            "checkpoint": self.cfg.checkpoint_path,
+            "config_file": self.cfg.config_file,
+            "config_file_type": str(self.setup_args.config_file_type),
+            "sampler": str(self.setup_args.sampler),
+            "domain_name": self.cfg.domain_name,
+            "domain_id": self.domain_id,
+            "action_dim": self.cfg.action_dim,
+            "action_chunk_size": self.cfg.action_chunk_size,
+            "action_rows_generated": self.cfg.action_chunk_size + (1 if self.cfg.use_state else 0),
+            "video_frames": self.cfg.action_chunk_size + 1,
+            "use_state": self.cfg.use_state,
+            "history_length": self.cfg.history_length,
+            "conditioning_fps": self.cfg.conditioning_fps,
+            "resolution": self.cfg.resolution,
+            # InstinctWM: the train/serve PARITY block, introspected off the LIVE transform
+            # object rather than off the requested config.
+            #
+            # This exists because a 22.7-hour eval was thrown away over exactly one of these
+            # fields. Training ran with format_prompt_as_json=True; the servers resolved False
+            # because the training config was not reachable, so the model was fed a prompt
+            # format it had never seen. The server logged a warning about it on startup and
+            # nothing read the startup log -- only /info. So every parity-relevant knob is
+            # reported here, where a pre-flight check can assert on it.
+            #
+            # Booleans are derived from whether the augmentor OBJECT exists, which is the
+            # resolved behaviour; a config field could say one thing while the pipeline does
+            # another.
+            "transform_parity": _transform_parity(self._transform),
+            # InstinctWM: read back from the RESOLVED setup args, not from the request, so
+            # /info reports what the engine is actually doing.
+            "use_cuda_graphs": bool(getattr(self.setup_args, "use_cuda_graphs", False)),
+            "cudagraphs_via_options": bool(getattr(self.setup_args, "cudagraphs_via_options", False)),
+            "compile_dynamic": bool(getattr(self.setup_args, "compile_dynamic", True)),
+            "compiled_region": str(getattr(self.setup_args, "compiled_region", "")),
+            "num_steps": self.cfg.num_steps,
+            "nfe_rungs": list(self.cfg.nfe_rungs),
+            "guidance": self.cfg.guidance,
+            "shift": self.cfg.shift,
+            "seed": self.cfg.seed,
+            "deterministic_seed": self.cfg.deterministic_seed,
+            "action_normalization": None,
+            "denormalization": "none",
+            "gripper_convention": "robotwin_native_1_is_open_no_flip",
+            "qpos14_layout": ["left_arm(6)", "left_gripper(1)", "right_arm(6)", "right_gripper(1)"],
+            "expected_image_hw": [self.cfg.expected_image_height, self.cfg.expected_image_width],
+            "view_description": ROBOTWIN_VIEW_DESC,
+            "view_description_source": _VIEW_DESC_SOURCE,
+            "guardrails": self.cfg.guardrails,
+            "sync_timing": self.cfg.sync_timing,
+            "decode_video": self.cfg.decode_video,
+            "episode_index": self._episode_index,
+            "requests_total": self._req_id,
+            "requests_this_episode": self._requests_this_episode,
+            "torch_version": torch.__version__,
+            "cuda_device": torch.cuda.get_device_name(0) if torch.cuda.is_available() else None,
+        }
+
+    def notify_next_episode(self, payload: dict[str, Any] | None = None) -> dict[str, Any]:
+        """Reset per-episode state.  The policy itself is stateless across chunks
+        (no KV cache is carried between requests, action row 0 always comes from the
+        client's ``qpos14``), so this only resets the seed stream, the per-episode
+        counters and — when asked — the CUDA peak-memory watermark."""
+        with self._lock:
+            self._episode_index += 1
+            self._requests_this_episode = 0
+            self._rng = np.random.default_rng(self.cfg.seed)
+            self.probe.reset()
+            if self.cfg.reset_peak_memory_per_request and torch.cuda.is_available():
+                torch.cuda.reset_peak_memory_stats()
+        episode_index = self._episode_index
+        log.info(f"[robotwin-policy-server] notify_next_episode -> episode_index={episode_index}")
+        return {
+            "status": "ok",
+            "episode_index": episode_index,
+            "seed_stream_reset_to": self.cfg.seed,
+            "echo": payload if isinstance(payload, dict) else None,
+        }
+
+    # ------------------------------------------------------------------
+    # Request preprocessing
+    # ------------------------------------------------------------------
+
+    def _prep_item(self, req: dict[str, Any]) -> dict[str, Any]:
+        """Validate one request and build the transformed model sample.
+
+        Request contract::
+
+            {"image": "<base64 png of the 320x360 mosaic>",
+             "prompt": "<instruction>",
+             "qpos14": [14 floats],            # or [[14 floats], ...] with history
+             "domain_name": "robotwin_aloha_agilex"}
+        """
+        image_b64 = req.get("image")
+        if not isinstance(image_b64, str):
+            raise ValueError("'image' must be a base64 PNG string")
+        prompt = req.get("prompt")
+        if not isinstance(prompt, str) or not prompt:
+            raise ValueError("'prompt' must be a non-empty string")
+        domain_name = req.get("domain_name") or self.cfg.domain_name
+        if not isinstance(domain_name, str):
+            raise ValueError("'domain_name' must be a string")
+
+        qpos = req.get("qpos14")
+        if qpos is None:
+            # Tolerated aliases so a harness written against a slightly different
+            # key still fails loudly rather than silently sending zeros.
+            qpos = req.get("state", req.get("qpos"))
+        if qpos is None:
+            raise ValueError(
+                f"'qpos14' is required: {self.cfg.action_dim} absolute joint positions "
+                "[left_arm(6), left_gripper, right_arm(6), right_gripper]"
+            )
+        qpos14 = _ensure_2d_float_array(qpos, "qpos14", self.cfg.action_dim)  # [T,14]
+
+        t0 = time.perf_counter()
+        img_chw_uint8 = _decode_base64_png_to_rgb_uint8(image_b64)  # [3,H,W]
+        image_decode_ms = (time.perf_counter() - t0) * 1000.0
+        img_h, img_w = int(img_chw_uint8.shape[-2]), int(img_chw_uint8.shape[-1])
+        exp_h, exp_w = self.cfg.expected_image_height, self.cfg.expected_image_width
+        if (exp_h is not None and img_h != exp_h) or (exp_w is not None and img_w != exp_w):
+            raise ValueError(
+                f"observation mosaic is {img_h}x{img_w} (HxW) but the frozen RoboTwin geometry is "
+                f"{exp_h}x{exp_w}: head_camera 320x240 on top, left|right resized to 160x120 below. "
+                "Pass --expected-image-height/--expected-image-width to relax this guard."
+            )
+
+        # Policy mode: video frame 0 is the observation (the only conditioning
+        # frame), the remaining chunk frames are generated, so they start as zeros.
+        t_frames = self.cfg.action_chunk_size + 1
+        video = torch.zeros((3, t_frames, img_h, img_w), dtype=torch.uint8)  # [3,T,H,W]
+        video[:, 0] = img_chw_uint8
+
+        use_state_rows = 1 if self.cfg.use_state else 0
+        action = torch.zeros((self.cfg.action_chunk_size + use_state_rows, self.cfg.action_dim), dtype=torch.float32)
+        history_action: torch.Tensor | None = None
+        num_history_rows = self.cfg.history_length - use_state_rows
+
+        # NO gripper flip: RoboTwin's native convention (1.0 = open) is what the
+        # dataset writes, so the state goes in exactly as received.
+        if self.cfg.use_state:
+            action[0] = torch.from_numpy(qpos14[-1])  # [D]
+        if num_history_rows > 0:
+            if len(qpos14) < num_history_rows + 1:
+                raise ValueError(
+                    f"'qpos14' needs {num_history_rows + 1} rows for --history-length="
+                    f"{self.cfg.history_length}, got {len(qpos14)}"
+                )
+            history_action = torch.from_numpy(qpos14[-num_history_rows - 1 : -1]).float()  # [H,D]
+
+        sample: dict[str, Any] = {
+            "ai_caption": prompt,
+            "video": video,
+            "action": action,
+            "conditioning_fps": torch.tensor(self.cfg.conditioning_fps, dtype=torch.long),  # []
+            "mode": "policy",
+            "domain_id": torch.tensor(self._domain_id(domain_name), dtype=torch.long),  # []
+            "viewpoint": "concat_view",
+            "additional_view_description": ROBOTWIN_VIEW_DESC,
+            # REQUIRED for prompt parity with training. ActionPromptJsonFormatter
+            # emits actions[0]["idle_frame"] = "<idle_frames> out of <T>." whenever
+            # this key is present, and _drop_empty_fields REMOVES the field when it
+            # is absent -- so omitting it makes every served prompt structurally
+            # different from every training prompt (the RoboTwin training dataset
+            # always sets it via ActionBaseDataset._build_result). Measured over the
+            # converted RoboTwin windows, 0 is the modal value (~50%), and the
+            # server cannot know the future idle count before predicting, so 0 is
+            # also the "keep moving" prior. Same value and rationale as
+            # action_policy_server_libero._build_json_prompt.
+            "idle_frames": torch.tensor(0, dtype=torch.long),  # []
+        }
+        if history_action is not None:
+            sample["history_action"] = history_action
+
+        t0 = time.perf_counter()
+        # action_normalizer=None -> action_normalization is None end to end. There is
+        # no stats file and nothing to invert on the way out.
+        sample = self._transform(sample, self.cfg.resolution, None)
+        if isinstance(sample.get("ai_caption"), dict):
+            sample["ai_caption"] = json.dumps(sample["ai_caption"])
+        transform_ms = (time.perf_counter() - t0) * 1000.0
+
+        return {
+            "sample": sample,
+            "data_batch": _build_data_batch_from_sample(sample),
+            "obs_chw_uint8": img_chw_uint8,
+            "prompt": sample.get("ai_caption"),
+            "domain_name": domain_name,
+            "image_hw": (img_h, img_w),
+            "image_decode_ms": image_decode_ms,
+            "transform_ms": transform_ms,
+        }
+
+    # ------------------------------------------------------------------
+    # Timing payload
+    # ------------------------------------------------------------------
+
+    def _build_timing_payload(
+        self,
+        *,
+        timings: _PhaseTimings,
+        t_arrival: float | None,
+        t0: float,
+        t_pre_done: float,
+        t_gen0: float,
+        t_gen1: float,
+        t_end: float,
+        video_decode_ms: float,
+        batch_size: int,
+        action_rows: int,
+        # InstinctWM: the step count THIS request ran at, which may differ from the launch
+        # default now that a rung is selectable per request. Threading it through keeps the
+        # server's own NFE cross-check honest -- that check compares measured network forwards
+        # against the expected count, and it is one of the few assertions here that would
+        # catch a sampler silently doing something else.
+        num_steps: int | None = None,
+    ) -> dict[str, Any]:
+        steps = int(num_steps if num_steps is not None else self.cfg.num_steps)
+        """Assemble the per-request timing breakdown.
+
+        Additivity contract — these components are mutually exclusive and sum to
+        ``total_ms`` up to ``residual_ms``::
+
+            preprocess_ms                (base64 decode + transform + batch build)
+          + model_prepare_ms             (vision_encode + prompt_tokenize + pack_prepare + prepare_other)
+          + generate_entry_ms            (generate_samples_from_batch entry -> first network forward)
+          + denoise_loop_ms              (first network forward -> last network forward returns)
+          + action_decode_ms             (last forward -> generate returns: latent split + postprocess_action)
+          + postprocess_ms               (tensor -> python lists, optional video decode)
+          + residual_ms
+          = total_ms
+
+        ``residual_ms`` is bookkeeping only (request-id assignment, dict shuffling)
+        and is expected to be well under 1 ms.  ``total_ms`` does NOT include the
+        handler's JSON serialization and socket write; those show up in the client's
+        wall time and in the ``http_total_ms`` figure written to the server log.
+        ``pack_in_denoise_ms`` is reported separately under ``nested`` because it is
+        *inside* ``denoise_loop_ms`` and would double-count if added.
+        """
+        ms = lambda a, b: (b - a) * 1000.0  # noqa: E731
+        total_ms = ms(t0, t_end)
+        preprocess_ms = ms(t0, t_pre_done)
+        prepare_ms = timings.prepare_ms
+        prepare_other_ms = prepare_ms - (
+            timings.vision_encode_ms + timings.prompt_tokenize_ms + timings.pack_prepare_ms
+        )
+        first_v = timings.first_velocity_t0
+        last_v = timings.last_velocity_t1
+        if first_v is None or last_v is None:
+            # No network forward happened (should be impossible); attribute
+            # everything after prepare to the denoise loop so the sum still closes.
+            generate_entry_ms = 0.0
+            denoise_loop_ms = ms(t_gen0, t_gen1) - prepare_ms
+            action_decode_ms = 0.0
+        else:
+            generate_entry_ms = ms(t_gen0, first_v) - prepare_ms
+            denoise_loop_ms = ms(first_v, last_v)
+            action_decode_ms = ms(last_v, t_gen1)
+        postprocess_ms = ms(t_gen1, t_end)
+
+        exclusive = [
+            preprocess_ms,
+            prepare_ms,
+            generate_entry_ms,
+            denoise_loop_ms,
+            action_decode_ms,
+            postprocess_ms,
+        ]
+        breakdown_sum_ms = float(sum(exclusive))
+        nfe = timings.nfe
+        expected_nfe = steps * (2 if self.cfg.guidance != 1.0 else 1)
+        per_step = _stats(timings.velocity_ms)
+
+        payload: dict[str, Any] = {
+            "total_ms": round(total_ms, 3),
+            "preprocess_ms": round(preprocess_ms, 3),
+            "model_prepare_ms": round(prepare_ms, 3),
+            "vision_encode_ms": round(timings.vision_encode_ms, 3),
+            "prompt_tokenize_ms": round(timings.prompt_tokenize_ms, 3),
+            "pack_sequence_ms": round(timings.pack_prepare_ms, 3),
+            "prepare_other_ms": round(prepare_other_ms, 3),
+            "generate_entry_ms": round(generate_entry_ms, 3),
+            "denoise_loop_ms": round(denoise_loop_ms, 3),
+            "denoise_step_ms": round(denoise_loop_ms / max(1, steps), 3),
+            "num_steps": steps,
+            "network_forward_ms": per_step,
+            "sampler_overhead_ms": round(denoise_loop_ms - float(sum(timings.velocity_ms)), 3),
+            "action_decode_ms": round(action_decode_ms, 3),
+            "postprocess_ms": round(postprocess_ms, 3),
+            "video_decode_ms": round(video_decode_ms, 3),
+            "breakdown_sum_ms": round(breakdown_sum_ms, 3),
+            "residual_ms": round(total_ms - breakdown_sum_ms, 3),
+            "queue_wait_ms": round(ms(t_arrival, t0), 3) if t_arrival is not None else None,
+            "nested": {
+                "pack_in_denoise_ms": round(timings.pack_in_denoise_ms, 3),
+                "note": "inside denoise_loop_ms; do not add to the exclusive components",
+            },
+            "counters": {
+                "denoise_steps": steps,
+                "nfe": nfe,
+                "nfe_expected": expected_nfe,
+                "guidance": self.cfg.guidance,
+                "batch_size": batch_size,
+                "action_chunk_size": self.cfg.action_chunk_size,
+                "action_rows_returned": action_rows,
+                "packed_sequence_tokens": timings.sequence_length,
+                "sync_timing": self.cfg.sync_timing,
+            },
+            "memory": {
+                "cuda_max_memory_allocated_mb": round(torch.cuda.max_memory_allocated() / 1024**2, 1)
+                if torch.cuda.is_available()
+                else None,
+                "cuda_memory_allocated_mb": round(torch.cuda.memory_allocated() / 1024**2, 1)
+                if torch.cuda.is_available()
+                else None,
+                "cuda_memory_reserved_mb": round(torch.cuda.memory_reserved() / 1024**2, 1)
+                if torch.cuda.is_available()
+                else None,
+                "peak_scope": "per_request" if self.cfg.reset_peak_memory_per_request else "process_lifetime",
+            },
+        }
+        if nfe != expected_nfe:
+            payload["counters"]["nfe_mismatch"] = (
+                f"measured {nfe} network forwards, expected steps({steps}) x "
+                f"{'2 (guidance != 1.0)' if self.cfg.guidance != 1.0 else '1'} = {expected_nfe}"
+            )
+        return payload
+
+    # ------------------------------------------------------------------
+    # Predict
+    # ------------------------------------------------------------------
+
+    def _assign_request_id(self, req: dict[str, Any]) -> int:
+        injected = req.get("request_id")
+        if isinstance(injected, int) and injected > 0:
+            return int(injected)
+        with self._req_id_lock:
+            self._req_id += 1
+            return int(self._req_id)
+
+    def _generate(self, data_batch: dict[str, Any], seeds: list[int],
+                  num_steps: int | None = None) -> tuple[dict[str, Any], _PhaseTimings, float, float]:
+        """Run one diffusion forward under the inference lock, with timers.
+
+        Returns ``(samples, timings, t_gen0, t_gen1)``."""
+        with self._lock:
+            if self.cfg.reset_peak_memory_per_request and torch.cuda.is_available():
+                torch.cuda.reset_peak_memory_stats()
+            self.probe.reset()
+            if self.cfg.sync_timing and torch.cuda.is_available():
+                torch.cuda.synchronize()
+            t_gen0 = time.perf_counter()
+            with torch.inference_mode():
+                samples = self.model.generate_samples_from_batch(
+                    data_batch,
+                    guidance=self.cfg.guidance,
+                    seed=seeds,
+                    num_steps=int(num_steps if num_steps is not None else self.cfg.num_steps),
+                    shift=self.cfg.shift,
+                    has_negative_prompt=False,
+                )
+            if self.cfg.sync_timing and torch.cuda.is_available():
+                torch.cuda.synchronize()
+            t_gen1 = time.perf_counter()
+            timings = self.probe.current
+        return samples, timings, t_gen0, t_gen1
+
+    def _extract_action(self, samples: dict[str, Any], index: int) -> np.ndarray:
+        """Model output -> the executable action chunk.
+
+        ``samples["action"][i]`` is ``[T,D_raw]`` in *external* space already
+        (``ActionProcessor.postprocess_action`` ran inside the model with our
+        ``action_normalizer=None`` record, i.e. it was a no-op).  Row 0 is the
+        ``use_state`` conditioning row and every extra history row precedes the
+        chunk, so ``history_length`` rows are dropped.
+
+        NO denormalization and NO gripper flip happen here, by contract."""
+        action = samples["action"][index]
+        if action.dim() == 3:
+            action = action.squeeze(0)
+        action = action[:, : self.cfg.action_dim]  # [T,D]
+        action = action[self.cfg.history_length :]  # [T2,D]
+        return action.float().detach().cpu().numpy()
+
+    def _resolve_num_steps(self, req: dict[str, Any]) -> int:
+        """InstinctWM: per-request NFE, bounded by the servable rungs.
+
+        Refusing an unlisted rung rather than serving it is deliberate: with capture enabled a
+        new step count is a new shape, and capturing it on arrival costs ~33 s measured -- a
+        stall in the middle of an episode. A refused request is visible; that stall is not.
+        """
+        want = req.get("num_steps")
+        if want is None:
+            return int(self.cfg.num_steps)
+        try:
+            want = int(want)
+        except (TypeError, ValueError):
+            raise ValueError(f"'num_steps' must be an integer, got {want!r}") from None
+        if want not in self.cfg.nfe_rungs:
+            raise ValueError(
+                f"num_steps={want} is not a servable rung. This process serves "
+                f"{list(self.cfg.nfe_rungs)}; launch it with --nfe-rungs to add more so they "
+                f"are warmed at startup. Serving an unwarmed rung would pay the capture cost "
+                f"mid-episode."
+            )
+        return want
+
+    def predict(self, req: dict[str, Any]) -> dict[str, Any]:
+        t_arrival = req.pop("_t_arrival", None)
+        t0 = time.perf_counter()
+        request_id = self._assign_request_id(req)
+
+        prep = self._prep_item(req)
+        t_pre_done = time.perf_counter()
+
+        seed = self._next_seed()
+        req_steps = self._resolve_num_steps(req)
+        log.info(
+            f"[robotwin-policy-server] request_id={request_id} episode={self._episode_index} "
+            f"domain={prep['domain_name']!r} img={prep['image_hw']} seed={seed} "
+            f"steps={req_steps} guidance={self.cfg.guidance} prompt={prep['prompt']!r}"
+        )
+
+        samples, timings, t_gen0, t_gen1 = self._generate(prep["data_batch"], [seed], req_steps)
+        action_np = self._extract_action(samples, 0)
+        action_list = action_np.tolist()
+
+        video_b64: list[str] = []
+        video_decode_ms = 0.0
+        pred_video: torch.Tensor | None = None
+        if self.cfg.decode_video:
+            t_vid = time.perf_counter()
+            with self._lock, torch.inference_mode():
+                pred_video = self.model.decode(samples["vision"][0]).squeeze(0)  # [C,T,H,W]
+            for frame in _video_tensor_to_pil_images(pred_video):
+                buf = io.BytesIO()
+                frame.save(buf, format="PNG")
+                video_b64.append(base64.b64encode(buf.getvalue()).decode("ascii"))
+            video_decode_ms = (time.perf_counter() - t_vid) * 1000.0
+
+        with self._req_id_lock:
+            self._requests_this_episode += 1
+        t_end = time.perf_counter()
+        timing = self._build_timing_payload(
+            timings=timings,
+            t_arrival=t_arrival,
+            t0=t0,
+            t_pre_done=t_pre_done,
+            t_gen0=t_gen0,
+            t_gen1=t_gen1,
+            t_end=t_end,
+            video_decode_ms=video_decode_ms,
+            batch_size=1,
+            action_rows=len(action_list),
+            num_steps=req_steps,
+        )
+        timing["image_decode_ms"] = round(prep["image_decode_ms"], 3)
+        timing["transform_ms"] = round(prep["transform_ms"], 3)
+
+        out: dict[str, Any] = {
+            "action": action_list,
+            "request_id": request_id,
+            "episode_index": self._episode_index,
+            "seed": seed,
+            "domain_name": prep["domain_name"],
+            "timing": timing,
+        }
+        if self.cfg.decode_video:
+            out["video"] = video_b64
+
+        log.info(
+            f"[robotwin-policy-server] request_id={request_id} done rows={len(action_list)} "
+            f"total={timing['total_ms']:.1f}ms pre={timing['preprocess_ms']:.1f} "
+            f"prepare={timing['model_prepare_ms']:.1f} (vae={timing['vision_encode_ms']:.1f} "
+            f"tok={timing['prompt_tokenize_ms']:.1f} pack={timing['pack_sequence_ms']:.1f} "
+            f"other={timing['prepare_other_ms']:.1f}) entry={timing['generate_entry_ms']:.1f} "
+            f"denoise={timing['denoise_loop_ms']:.1f} (step={timing['denoise_step_ms']:.1f} x "
+            f"{timing['counters']['nfe']} nfe) adec={timing['action_decode_ms']:.1f} "
+            f"post={timing['postprocess_ms']:.1f} residual={timing['residual_ms']:.2f} "
+            f"tokens={timing['counters']['packed_sequence_tokens']} "
+            f"peak_mem={timing['memory']['cuda_max_memory_allocated_mb']}MB"
+        )
+
+        if self._should_dump(request_id):
+            self._dump_request(request_id, req, prep, action_list, timing, pred_video)
+        return out
+
+    def predict_batch(self, items: list[dict[str, Any]]) -> dict[str, Any]:
+        """N observations -> ONE diffusion forward -> N action chunks.
+
+        Exists for the throughput A/B in ``results/infra_baseline.csv``: it shares
+        all the fixed per-chunk overhead across N requests, which is the cheapest
+        possible stand-in for continuous batching."""
+        t_arrival = None
+        if items and isinstance(items[0], dict):
+            t_arrival = items[0].pop("_t_arrival", None)
+        t0 = time.perf_counter()
+        if not isinstance(items, list) or not items:
+            raise ValueError("'items' must be a non-empty list of policy requests")
+        for item in items:
+            if not isinstance(item, dict):
+                raise ValueError("every entry of 'items' must be a JSON object")
+            item.pop("_t_arrival", None)
+
+        preps = [self._prep_item(item) for item in items]
+        data_batch = _merge_data_batches([p["data_batch"] for p in preps])
+        n = len(preps)
+        t_pre_done = time.perf_counter()
+
+        seeds = [self._next_seed() for _ in range(n)]
+        samples, timings, t_gen0, t_gen1 = self._generate(data_batch, seeds)
+        actions = [self._extract_action(samples, i).tolist() for i in range(n)]
+
+        with self._req_id_lock:
+            self._requests_this_episode += n
+        t_end = time.perf_counter()
+        timing = self._build_timing_payload(
+            timings=timings,
+            t_arrival=t_arrival,
+            t0=t0,
+            t_pre_done=t_pre_done,
+            t_gen0=t_gen0,
+            t_gen1=t_gen1,
+            t_end=t_end,
+            video_decode_ms=0.0,
+            batch_size=n,
+            action_rows=len(actions[0]) if actions else 0,
+        )
+        timing["image_decode_ms"] = round(sum(p["image_decode_ms"] for p in preps), 3)
+        timing["transform_ms"] = round(sum(p["transform_ms"] for p in preps), 3)
+        timing["per_item_total_ms"] = round(timing["total_ms"] / max(1, n), 3)
+        log.info(
+            f"[robotwin-policy-server] predict_batch n={n} steps={self.cfg.num_steps} "
+            f"total={timing['total_ms']:.1f}ms per_item={timing['per_item_total_ms']:.1f}ms "
+            f"denoise={timing['denoise_loop_ms']:.1f}ms tokens={timing['counters']['packed_sequence_tokens']}"
+        )
+        return {"actions": actions, "seeds": seeds, "timing": timing}
+
+    # ------------------------------------------------------------------
+    # Debug dumps
+    # ------------------------------------------------------------------
+
+    def _dump_request(
+        self,
+        request_id: int,
+        req: dict[str, Any],
+        prep: dict[str, Any],
+        action: list[list[float]],
+        timing: dict[str, Any],
+        pred_video: torch.Tensor | None,
+    ) -> None:
+        if self.cfg.dump_dir is None:
+            return
+        try:
+            ts = datetime.datetime.now(tz=datetime.timezone.utc).strftime("%Y%m%d_%H%M%S_%fZ")
+            out_dir = Path(self.cfg.dump_dir) / f"{ts}_req{request_id:06d}"
+            out_dir.mkdir(parents=True, exist_ok=True)
+            request_copy = {k: v for k, v in req.items() if k != "image"}
+            request_copy["image"] = "<saved as observation.png>"
+            (out_dir / "request.json").write_text(json.dumps(request_copy, indent=2), encoding="utf-8")
+            (out_dir / "action_output.json").write_text(
+                json.dumps({"action": action, "prompt": prep["prompt"]}, indent=2), encoding="utf-8"
+            )
+            (out_dir / "timing.json").write_text(json.dumps(timing, indent=2), encoding="utf-8")
+            obs_hwc = prep["obs_chw_uint8"].permute(1, 2, 0).cpu().numpy()  # [H,W,3]
+            Image.fromarray(obs_hwc).save(out_dir / "observation.png")
+            if pred_video is not None:
+                frames_dir = out_dir / "rollout_frames"
+                frames_dir.mkdir(parents=True, exist_ok=True)
+                for i, frame in enumerate(_video_tensor_to_pil_images(pred_video)):
+                    frame.save(frames_dir / f"frame_{i:03d}.png")
+            log.info(f"[robotwin-policy-server] request_id={request_id} dumped to {out_dir}")
+        except Exception as exc:  # noqa: BLE001 - never fail a request because of a dump
+            log.error(f"[robotwin-policy-server] dump failed for request_id={request_id}: {exc}")
+
+    def dump_failure(self, request_id: int, req: dict[str, Any], error: str) -> None:
+        if self.cfg.dump_dir is None:
+            return
+        try:
+            ts = datetime.datetime.now(tz=datetime.timezone.utc).strftime("%Y%m%d_%H%M%S_%fZ")
+            out_dir = Path(self.cfg.dump_dir) / f"{ts}_req{request_id:06d}_ERROR"
+            out_dir.mkdir(parents=True, exist_ok=True)
+            request_copy = {k: v for k, v in req.items() if k != "image"}
+            if "image" in req:
+                request_copy["image"] = "<attempted to save as observation.png>"
+            (out_dir / "request.json").write_text(json.dumps(request_copy, indent=2), encoding="utf-8")
+            (out_dir / "error.txt").write_text(error, encoding="utf-8")
+            image_b64 = req.get("image")
+            if isinstance(image_b64, str):
+                chw = _decode_base64_png_to_rgb_uint8(image_b64)
+                Image.fromarray(chw.permute(1, 2, 0).cpu().numpy()).save(out_dir / "observation.png")
+        except Exception:  # noqa: BLE001
+            return
+
+
+# ---------------------------------------------------------------------------
+# HTTP handler
+# ---------------------------------------------------------------------------
+
+
+class _RobotwinHandler(BaseHTTPRequestHandler):
+    """ThreadingHTTPServer handler; the service is injected as ``server.service``."""
+
+    server: ThreadingHTTPServer  # type: ignore[assignment]
+    protocol_version = "HTTP/1.1"  # keep-alive: TCP setup is measurable at ~1s/chunk
+
+    def _service(self) -> RobotwinPolicyService:
+        return getattr(self.server, "service")  # type: ignore[attr-defined]
+
+    def _send_json(self, status_code: int, payload: dict[str, Any]) -> None:
+        body = json.dumps(payload).encode("utf-8")
+        self.send_response(status_code)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Cache-Control", "no-store")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        try:
+            self.wfile.write(body)
+        except (BrokenPipeError, ConnectionResetError):
+            return
+
+    def do_GET(self) -> None:  # noqa: N802
+        if self.path == "/info":
+            self._send_json(200, self._service().get_info())
+        elif self.path in ("/", "/healthz"):
+            self._send_json(200, {"status": "ok"})
+        else:
+            self._send_json(404, {"error": "Not found"})
+
+    def do_POST(self) -> None:  # noqa: N802
+        t_arrival = time.perf_counter()
+        if self.path not in ("/", "/predict", "/predict_batch", "/notify_next_episode"):
+            self._send_json(404, {"error": "Not found"})
+            return
+
+        try:
+            length = int(self.headers.get("Content-Length") or "0")
+        except ValueError:
+            self._send_json(400, {"error": "Invalid Content-Length"})
+            return
+        body = self.rfile.read(max(0, length))
+
+        content_type = (self.headers.get("Content-Type") or "").split(";", 1)[0].strip().lower()
+        if self.path == "/notify_next_episode" and not body:
+            self._send_json(200, self._service().notify_next_episode(None))
+            return
+        if content_type != "application/json":
+            self._send_json(415, {"error": "Content-Type must be application/json"})
+            return
+
+        try:
+            req = json.loads(body.decode("utf-8"))
+        except Exception as exc:  # noqa: BLE001
+            self._send_json(400, {"error": f"Invalid JSON: {exc}"})
+            return
+
+        service = self._service()
+
+        if self.path == "/notify_next_episode":
+            self._send_json(200, service.notify_next_episode(req if isinstance(req, dict) else None))
+            return
+
+        is_batch = self.path == "/predict_batch"
+        if is_batch:
+            # Accept either a bare JSON list or {"items": [...]}.
+            items = req if isinstance(req, list) else (req.get("items") if isinstance(req, dict) else None)
+            if not isinstance(items, list):
+                self._send_json(400, {"error": "POST /predict_batch expects a JSON list or {'items': [...]}"})
+                return
+            if items and isinstance(items[0], dict):
+                items[0]["_t_arrival"] = t_arrival
+            payload_for_dump: dict[str, Any] = {"items": f"<{len(items)} items>"}
+        else:
+            if not isinstance(req, dict):
+                self._send_json(400, {"error": "POST /predict expects a JSON object"})
+                return
+            req["_t_arrival"] = t_arrival
+            payload_for_dump = req
+
+        try:
+            out = service.predict_batch(items) if is_batch else service.predict(req)
+        except Exception as exc:  # noqa: BLE001
+            err = str(exc)
+            traceback.print_exc()
+            log.error(f"[robotwin-policy-server] path={self.path} ERROR: {err}")
+            service.dump_failure(0, payload_for_dump if isinstance(payload_for_dump, dict) else {}, err)
+            status = 400 if service.cfg.http_400_on_error else 200
+            self._send_json(status, {"actions": [], "error": err} if is_batch else {"action": [], "error": err})
+            return
+
+        self._send_json(200, out)
+        log.info(
+            f"[robotwin-policy-server] http path={self.path} "
+            f"http_total_ms={(time.perf_counter() - t_arrival) * 1000.0:.1f} "
+            "(includes body read + JSON encode + socket write)"
+        )
+
+    def log_message(self, format: str, *args: Any) -> None:  # noqa: A002
+        return
+
+
+# ---------------------------------------------------------------------------
+# Entrypoint
+# ---------------------------------------------------------------------------
+
+
+def serve(args: RobotwinServerArgs) -> None:
+    if args.dump_dir is not None:
+        Path(args.dump_dir).resolve().mkdir(parents=True, exist_ok=True)
+        log.info(f"[robotwin-policy-server] dump_root={Path(args.dump_dir).resolve()} dump_every={args.dump_every}")
+    if args.guardrails:
+        log.warning(
+            "[robotwin-policy-server] --guardrails is ON: OmniInference will try to load "
+            "nvidia/Cosmos-Guardrail1, which is a GATED HuggingFace repo and will fail startup "
+            "without access. Guardrails filter text/video content only and change nothing we measure."
+        )
+
+    service = RobotwinPolicyService(args)
+    local_ip = get_local_ip()
+    log.info(f"[robotwin-policy-server] Server accessible at: http://{local_ip}:{int(args.port)}/")
+    log.info("[robotwin-policy-server] Endpoints:")
+    log.info("  - GET  /                    : health check")
+    log.info("  - GET  /info                : resolved runtime config")
+    log.info("  - POST /predict             : {image,prompt,qpos14,domain_name} -> {action[16][14],timing}")
+    log.info("  - POST /predict_batch       : [ {...}, ... ] -> {actions,timing}")
+    log.info("  - POST /notify_next_episode : reset per-episode state")
+
+    httpd = ThreadingHTTPServer((args.host, int(args.port)), _RobotwinHandler)
+    setattr(httpd, "service", service)
+    httpd.serve_forever()
+
+
+def main() -> None:
+    cascade_subcommand_args = getattr(
+        tyro.conf,
+        "CascadeSubcommandArgs",
+        tyro.conf.ConsolidateSubcommandArgs,
+    )
+    args = tyro_cli(
+        RobotwinServerArgs,
+        description=__doc__,
+        config=(
+            tyro.conf.OmitArgPrefixes,
+            cascade_subcommand_args,
+            tyro.conf.OmitSubcommandPrefixes,
+        ),
+    )
+    serve(args)
+
+
+if __name__ == "__main__":
+    main()

+# ---------------------------------------------------------------------------
+# Image / array helpers
+# ---------------------------------------------------------------------------
+
+
+def _strip_data_url_prefix(b64: str) -> str:
+    if "," in b64 and b64[:64].lower().startswith("data:"):
+        return b64.split(",", 1)[1].strip()
+    return b64.strip()
+
+
+def _b64decode_loose(b64: str) -> bytes:
+    """Decode base64 permissively (clients may add whitespace, drop padding, or use urlsafe)."""
+    s = _strip_data_url_prefix(b64)
+    s = "".join(s.split())
+    pad = (-len(s)) % 4
+    if pad:
+        s = s + ("=" * pad)
+    try:
+        return base64.b64decode(s, validate=False)
+    except binascii.Error:
+        return base64.urlsafe_b64decode(s)
+
+
+def _decode_base64_png_to_rgb_uint8(image_b64: str) -> torch.Tensor:
+    """base64 PNG -> uint8 RGB tensor ``[3,H,W]``.
+
+    The client is responsible for building the mosaic and PNG-encoding *RGB*
+    channel order.  RoboTwin's hdf5 stores ``cv2.imencode`` output of an RGB
+    array, so the harness must decode with ``cv2.imdecode`` and PNG-encode the
+    resulting RGB array without a channel swap."""
+    try:
+        raw = _b64decode_loose(image_b64)
+    except (binascii.Error, ValueError) as exc:
+        raise ValueError(f"Invalid base64 image: {exc}") from exc
+
+    with Image.open(io.BytesIO(raw)) as img:
+        img = img.convert("RGB")
+        arr = np.asarray(img, dtype=np.uint8).copy()
+    if arr.ndim != 3 or arr.shape[2] != 3:
+        raise ValueError(f"Expected RGB image, got shape {arr.shape}")
+    return torch.from_numpy(arr).permute(2, 0, 1).contiguous()  # [3,H,W]
+
+
+def _ensure_2d_float_array(value: Any, key: str, width: int) -> np.ndarray:
+    """Coerce ``[D]`` or ``[T,D]`` to a contiguous float32 ``[T,D]`` array."""
+    array = np.asarray(value, dtype=np.float32)
+    if array.ndim == 1:
+        array = array[None, :]
+    if array.ndim != 2:
+        raise ValueError(f"{key!r} must have shape [T,D] or [D], got {array.shape}")
+    if array.shape[-1] != width:
+        raise ValueError(f"{key!r} must have width {width}, got {array.shape[-1]}")
+    if not np.isfinite(array).all():
+        raise ValueError(f"{key!r} contains non-finite values")
+    return np.ascontiguousarray(array)
+
+
+def _build_data_batch_from_sample(sample: dict[str, Any]) -> dict[str, Any]:
+    """Wrap a single transformed sample into the model's collated batch layout."""
+    data_batch: dict[str, Any] = {}
+    for key, value in sample.items():
+        if key in IterativeJointDataLoader._MULTI_ITEM_KEYS:
+            data_batch[key] = [[value]]
+        elif isinstance(value, torch.Tensor):
+            data_batch[key] = [value.unsqueeze(0)]  # value: [...], batch item: [1,...]
+        else:
+            data_batch[key] = [value]
+    return data_batch
+
+
+def _merge_data_batches(batches: list[dict[str, Any]]) -> dict[str, Any]:
+    """Concatenate per-sample batch dicts into one batch of size N.
+
+    Every value produced by ``_build_data_batch_from_sample`` is a length-1 list,
+    so merging is a plain list concat.  Keys must agree across samples."""
+    if not batches:
+        raise ValueError("cannot merge an empty batch list")
+    keys = set(batches[0])
+    for other in batches[1:]:
+        if set(other) != keys:
+            raise ValueError(
+                f"batch items produced different keys: {sorted(keys ^ set(other))}; refusing to build a ragged batch"
+            )
+    merged: dict[str, Any] = {}
+    for key in batches[0]:
+        merged[key] = [item for batch in batches for item in batch[key]]
+    return merged
+
+
+def _video_tensor_to_pil_images(video_c_t_h_w: torch.Tensor) -> list[Image.Image]:
+    if video_c_t_h_w.dim() != 4:
+        raise ValueError(f"Expected (C,T,H,W), got {tuple(video_c_t_h_w.shape)}")
+    images: list[Image.Image] = []
+    for ti in range(int(video_c_t_h_w.shape[1])):
+        frame = video_c_t_h_w[:, ti].detach().cpu().float()
+        if frame.min().item() < 0.0:
+            frame = (frame + 1.0) / 2.0
+        frame_uint8 = (frame.clamp(0.0, 1.0) * 255.0).round().to(torch.uint8)  # [3,H,W]
+        images.append(Image.fromarray(frame_uint8.permute(1, 2, 0).numpy()))
+    return images
+
+
+class _DummyDataset(torch.utils.data.IterableDataset):
+    """Placeholder swapped in for the training dataset so the wrapper that owns the
+    transform can be instantiated without touching the real data root."""
+
+    def __iter__(self) -> Any:
+        return iter(())
+

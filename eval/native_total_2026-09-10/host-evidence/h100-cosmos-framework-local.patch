diff --git a/cosmos_framework/configs/base/defaults/compile.py b/cosmos_framework/configs/base/defaults/compile.py
index 3d5ebf7..22c0d34 100644
--- a/cosmos_framework/configs/base/defaults/compile.py
+++ b/cosmos_framework/configs/base/defaults/compile.py
@@ -31,6 +31,21 @@ class CompileConfig:
     # Whether to use CUDA graphs for faster inference. This option does not work during training.
     use_cuda_graphs: bool = False
 
+    # InstinctWM: get CUDA-graph capture WITHOUT changing kernel selection.
+    #
+    # `use_cuda_graphs` currently sets torch.compile(mode="reduce-overhead"), which switches on
+    # cudagraph trees AND changes inductor's fusion and memory-planning decisions. Measured
+    # consequence: actions move by max|Δ| = 1.72e-02 versus the uncaptured path, so the engine
+    # arm cannot claim bit-exactness and has to buy a non-inferiority certificate instead.
+    #
+    # Capture itself should be numerically neutral -- it records and replays the same kernel
+    # launches, and static addresses do not change arithmetic. So the delta is very likely the
+    # MODE, not the capture. With this on, cudagraphs are requested through
+    # `options={"triton.cudagraphs": True}` with mode left at the default, which keeps
+    # inductor's ordinary decisions. If that turns out bit-exact, the 3.5x at NFE 30 comes for
+    # free and the certificate is unnecessary.
+    cudagraphs_via_options: bool = False
+
     # Enable autotuning for pointwise/reduction Triton kernels (e.g. RMSNorm).
     # Explores 6 candidate configs instead of the default 1, improving kernel performance
     # at the cost of longer first-iteration compilation time.

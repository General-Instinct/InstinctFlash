+def get_action_robotwin_sft_dataset(
+    *,
+    root: str,
+    fps: float = 16.0,
+    chunk_length: int = 16,
+    mode: str = "policy",
+    use_state: bool = True,
+    action_normalization: str | None = None,
+    viewpoint: str = "concat_view",
+    use_image_augmentation: bool = False,
+    split: str = "full",
+    val_ratio: float = 0.01,
+    seed: int = 0,
+    resolution: str | int | None = "480",
+    max_action_dim: int = 64,
+    tokenizer_config: dict | None = None,
+    cfg_dropout_rate: float = 0.1,
+    append_viewpoint_info: bool = True,
+    append_duration_fps_timestamps: bool = True,
+    append_resolution_info: bool = True,
+    append_idle_frames: bool = False,
+    format_prompt_as_json: bool = True,
+    iterable_shuffle: bool = True,
+    episode_shuffle_seed: int = 42,
+) -> Dataset:
+    """Build the RoboTwin 2.0 ``aloha-agilex`` action SFT dataset.
+
+    Mirrors :func:`get_action_droid_sft_dataset`: feeds
+    ``RoboTwinLeRobotDataset`` (14-D absolute joint position ``qpos14``,
+    ``use_state=True`` so the current state is conditioning row 0, raw /
+    un-normalized, no gripper flip) through ``ActionTransformPipeline``.
+
+    ``root`` is ONE local LeRobot v3.0 root covering all pilot tasks (one
+    multi-task checkpoint); ``viewpoint="concat_view"`` reads the single
+    pre-composed ``observation.images.mosaic`` video key.
+
+    ``resolution="480"`` is the tier whose closest aspect bucket (``"1,1"`` ->
+    640x640) is >= the 320x360 mosaic in both dimensions, so
+    ``reflection_pad_to_target`` caps ``scaling_ratio`` at 1.0 and the mosaic
+    reaches the model at NATIVE pixel scale (padded, never resampled). The
+    ``"256"`` tier would resolve to 256x256 and downscale the mosaic to 228x256
+    (-29% linear), i.e. crush the 320x240 head camera to 228x171.
+
+    ``use_image_augmentation`` is accepted for signature parity with the DROID
+    factory and must stay ``False``: ``RoboTwinLeRobotDataset`` has no augmentor
+    (random crop/rescale would break the frozen mosaic geometry the policy
+    server reproduces at eval time).
+    """
+    if use_image_augmentation:
+        raise NotImplementedError(
+            "RoboTwinLeRobotDataset has no image augmentor; cropping/rescaling would break the "
+            "frozen mosaic geometry shared with the policy server. Keep use_image_augmentation=False."
+        )
+    dataset: Dataset = RoboTwinLeRobotDataset(
+        root=root,
+        fps=fps,
+        chunk_length=chunk_length,
+        mode=mode,
+        use_state=use_state,
+        viewpoint=viewpoint,
+        action_normalization=action_normalization,
+        split=split,
+        val_ratio=val_ratio,
+        seed=seed,
+    )
+    transform = ActionTransformPipeline(
+        tokenizer_config=tokenizer_config,
+        cfg_dropout_rate=cfg_dropout_rate,
+        max_action_dim=max_action_dim,
+        append_viewpoint_info=append_viewpoint_info,
+        append_duration_fps_timestamps=append_duration_fps_timestamps,
+        append_resolution_info=append_resolution_info,
+        append_idle_frames=append_idle_frames,
+        format_prompt_as_json=format_prompt_as_json,
+    )
+    sft = ActionSFTDataset(dataset, transform, resolution)
+    if iterable_shuffle:
+        return ActionIterableShuffleDataset(sft, seed=episode_shuffle_seed)
+    return sft
+
+

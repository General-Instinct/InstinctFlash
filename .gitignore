__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# uv materialises the three environments here (.venv core, .venv-dev, .venv-server);
# uv.lock IS committed -- it is the artifact that makes "the env that produced this
# number" reconstructable.
.venv-*/

# Run artifacts live outside the repo (/home/ubuntu/iwm_*), but guard against
# anyone pointing IWM_RESULT_DIR / IWM_LOG_DIR at the working tree by accident.
results/
logs/
*.npz
*.qdstrm
*.nsys-rep
cycle_trace.json

# Design docs stay local (not published)
docs/

# Generated certificates. A certificate is the OUTPUT of a certification run, not source: the two
# that were committed by accident carried delta -0.030 and -0.040, both superseded by the 2V/4A
# certificate at -0.019 over 566 pairs. A stale certificate in the tree is worse than none, because
# it looks authoritative.
certificate.json
**/certificate.json
examples/external_plugin/my-world-model/
examples/external_plugin/*.egg-info/
dist/
